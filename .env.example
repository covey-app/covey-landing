# Copy to .env and fill in.
#
#     cp .env.example .env
#
# Only PUBLIC_-prefixed values reach the browser bundle; Astro inlines them at
# build time. Never put a secret behind PUBLIC_.

# ---------------------------------------------------------------------------
# Sentry — error monitoring
# ---------------------------------------------------------------------------

# Browser DSN from Sentry → Settings → Projects → <project> → Client Keys.
# Safe to ship: a DSN is a write-only ingest endpoint, not a credential.
#
# Leave EMPTY and the SDK is not merely disabled — it is tree-shaken out of the
# bundle entirely, because sentry.client.config.ts guards init behind this
# value and Vite eliminates the dead branch. Setting it adds roughly 27KB
# gzipped of deferred JavaScript to a site that otherwise ships ~16KB, so this
# is a deliberate on/off switch, not a formality.
PUBLIC_SENTRY_DSN=

# "production" | "preview" | "development". Defaults to "production".
PUBLIC_SENTRY_ENVIRONMENT=

# Optional. Ties events to a release; a commit SHA works.
PUBLIC_SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Waitlist (server only — read at request time via astro:env/server)
# ---------------------------------------------------------------------------
#
# Set these in Vercel → Settings → Environment Variables, Production scope,
# marked Sensitive. They never reach the browser. Leave them empty locally and
# /api/waitlist answers 503 "not_configured" (the form shows a retry message);
# it never pretends to succeed. See docs/waitlist.md.

# The Supabase project's API URL, e.g. https://api.coveyapp.co
SUPABASE_URL=

# service_role key (legacy JWT) or an sb_secret_… key. NEVER prefix with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend: optional for the waitlist confirmation; required to send Covey
# Weekly confirmations and editions (docs/content.md).
RESEND_API_KEY=
WAITLIST_EMAIL_FROM=
# Sender for Covey Weekly; falls back to WAITLIST_EMAIL_FROM.
NEWSLETTER_EMAIL_FROM=
