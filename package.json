{
  "name": "covey-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env scripts/preview.mjs",
    "check": "astro check",
    "og": "node scripts/gen-og.mjs",
    "tokens:generate": "node scripts/design-tokens/generate.mjs",
    "tokens:check": "node scripts/design-tokens/generate.mjs --check",
    "tokens:verify": "node scripts/design-tokens/verify.mjs && node scripts/design-tokens/generate.mjs --check",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:db": "sh scripts/test-db.sh",
    "test": "npm run test:unit && astro check && astro build && playwright test",
    "content:import": "node scripts/content/import-sheet.mjs",
    "newsletter:send": "node --env-file-if-exists=.env scripts/newsletter/send-edition.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.14",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@sentry/astro": "^10.74.0",
    "astro": "^7.1.3",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.160.0",
    "lucide-static": "^1.48.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
