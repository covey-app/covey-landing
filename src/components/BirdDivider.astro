---
// A quiet section divider — a hairline rule flanking the flock dot cluster.
import CoveyMark from "./CoveyMark.astro";
---

<div class="flex items-center justify-center gap-4 py-2">
  <span class="h-px w-16 md:w-32 bg-edge"></span>
  <CoveyMark variant="dots" dotSize={6} />
  <span class="h-px w-16 md:w-32 bg-edge"></span>
</div>
