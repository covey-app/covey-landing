---
/*
 * CoveyCard — a Covey's page, condensed (covey-ios People/CoveyDetailView):
 * name + privacy, members, the recurring-plan rule ("Every 2 weeks ·
 * Saturdays at 5:30 PM", "Next: …"), and the upcoming plan it produced.
 * Illustrative; labeled as an example.
 */
import Icon from "./Icon.astro";

const members = [
  { i: "M", c: "food" },
  { i: "D", c: "sports" },
  { i: "S", c: "arts" },
  { i: "L", c: "outdoors" },
  { i: "P", c: "fashion" },
  { i: "J", c: "professional" },
];
const stops = [
  { c: "food", icon: "coffee" as const },
  { c: "outdoors", icon: "mountain" as const },
  { c: "culture", icon: "sunset" as const },
];
---

<article class="covey-card" aria-label="Example Covey: Sunset walkers">
  <header class="cc-head">
    <div>
      <p class="eyebrow">Example Covey</p>
      <h3 class="cc-name">Sunset walkers</h3>
      <p class="cc-sub">6 members · Outer Richmond</p>
    </div>
    <span class="badge badge-accent">Invite only</span>
  </header>

  <ul class="cc-members" aria-label="6 members">
    {
      members.map((m) => (
        <li class="cc-avatar" style={`--c-soft:var(--cat-${m.c}-soft); --c-ink:var(--cat-${m.c}-ink)`}>
          <span aria-hidden="true">{m.i}</span>
        </li>
      ))
    }
  </ul>

  <div class="cc-block">
    <p class="eyebrow mb-2">Recurring</p>
    <p class="cc-rule">
      <Icon name="repeat" size={16} />
      Every 2 weeks · Saturdays at 5:30 pm
    </p>
    <p class="cc-next">Next: Saturday · every member is invited</p>
  </div>

  <div class="cc-block cc-upcoming">
    <p class="eyebrow mb-3">Upcoming plans · 1</p>
    <div class="cc-plan">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="badge badge-neutral">Casual</span>
        <span class="badge badge-accent">Invite</span>
        <span class="cc-going"><Icon name="users" size={13} /> 5/6 going</span>
      </div>
      <p class="cc-plan-title">Lands End sunset walk</p>
      <div class="flex items-center gap-2">
        {
          stops.map((s) => (
            <span class="orb" style={`--orb:24px; --c:var(--cat-${s.c})`} aria-hidden="true">
              <Icon name={s.icon} />
            </span>
          ))
        }
      </div>
      <p class="meta-line mt-3"><span>Sat</span><span>5:30 pm</span><span>3 stops</span></p>
    </div>
  </div>
</article>

<style>
  .covey-card {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius-sheet);
    background-color: var(--paper-elevated);
    border: 0.7px solid color-mix(in oklab, var(--edge) 55%, transparent);
    box-shadow: var(--shadow-pinned);
  }
  @media (min-width: 640px) {
    .covey-card {
      padding: 2rem;
    }
  }
  .cc-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .cc-name {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
    margin-top: 0.35rem;
  }
  .cc-sub {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .cc-members {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cc-avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background-color: var(--c-soft);
    color: var(--c-ink);
    border: 2px solid var(--paper-elevated);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8125rem;
  }
  .cc-avatar + .cc-avatar {
    margin-left: -6px;
  }
  .cc-block {
    padding-top: 1.1rem;
    border-top: 0.7px solid var(--edge);
  }
  .cc-rule {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .cc-rule :global(svg) {
    color: var(--accent-ink);
    flex: none;
  }
  .cc-next {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  /* On phones the journey below already shows the plan; skip the repeat. */
  .cc-upcoming {
    display: none;
  }
  @media (min-width: 640px) {
    .cc-upcoming {
      display: block;
    }
  }
  .cc-plan {
    padding: 1rem 1.1rem;
    border-radius: var(--radius-lg);
    background-color: var(--paper);
  }
  .cc-going {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--accent);
  }
  .cc-plan-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.1875rem;
    color: var(--ink);
    margin: 0.7rem 0 0.65rem;
  }
</style>
