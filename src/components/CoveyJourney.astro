---
/*
 * CoveyJourney — "the second hangout": how one plan becomes a habit, using
 * only features that ship in covey-ios today:
 *   - recaps ("This plan happened — share how it went.", PlanDetailView)
 *   - Coveys, standing groups (CoveysTab, CoveyEditorSheet; privacy options
 *     Open / Request to join / Invite only / Private)
 *   - recurring plans inside a Covey (Weekly / Every 2 weeks / Monthly; an
 *     admin schedules the next occurrence and every member is invited)
 * Deliberately absent: "plan again", inviting past attendees, crews-from-a-
 * plan — none has UI in the app yet.
 *
 * The four beats are joined by the dashed route thread, drawn left→right as
 * the section enters (reveal system in BaseLayout). Resting style = drawn.
 */
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

const beats: {
  when: string;
  title: string;
  body: string;
  icon: IconName;
  cat: string;
  tag: string;
}[] = [
  {
    when: "Saturday",
    title: "Join a plan",
    body: "Four people who'd never met walk the cliffs at Lands End.",
    icon: "sunset",
    cat: "outdoors",
    tag: "4/6 going",
  },
  {
    when: "Sunday",
    title: "Post a recap",
    body: "This plan happened — share how it went. Photos, and who was there.",
    icon: "camera",
    cat: "arts",
    tag: "Maya, Dev + 2 more",
  },
  {
    when: "Tuesday",
    title: "Start a Covey",
    body: "Turn a great hangout into a standing group — open, request-to-join, or invite-only.",
    icon: "users",
    cat: "sports",
    tag: "Sunset walkers",
  },
  {
    when: "Every other Saturday",
    title: "Keep meeting up",
    body: "Set a recurring plan. When the next one is scheduled, every member gets the invite.",
    icon: "repeat",
    cat: "food",
    tag: "Every 2 weeks",
  },
];
---

<ol class="journey reveal" aria-label="From one plan to a standing group">
  <span class="journey-thread" aria-hidden="true"></span>
  {
    beats.map((b, i) => (
      <li class="beat" style={`--i:${i}; --c:var(--cat-${b.cat}); --c-soft:var(--cat-${b.cat}-soft); --c-ink:var(--cat-${b.cat}-ink)`}>
        <span class="orb beat-orb" aria-hidden="true">
          <Icon name={b.icon} />
        </span>
        <p class="beat-when">{b.when}</p>
        <h3 class="beat-title">{b.title}</h3>
        <p class="beat-body">{b.body}</p>
        <span class="act-chip beat-tag">{b.tag}</span>
      </li>
    ))
  }
</ol>

<style>
  .journey {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 900px) {
    .journey {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  /* Vertical thread on phones, horizontal on wide screens. */
  .journey-thread {
    position: absolute;
    left: 21px;
    top: 22px;
    bottom: 22px;
    border-left: 1.5px dashed color-mix(in oklab, var(--ink-subtle) 75%, transparent);
  }
  @media (min-width: 900px) {
    .journey-thread {
      left: 22px;
      right: calc(25% - 1.25rem);
      top: 22px;
      bottom: auto;
      border-left: 0;
      border-top: 1.5px dashed color-mix(in oklab, var(--ink-subtle) 75%, transparent);
    }
  }

  .beat {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 1rem;
    align-items: start;
    padding-bottom: 1.75rem;
  }
  .beat:last-child {
    padding-bottom: 0;
  }
  .beat > :not(.beat-orb) {
    grid-column: 2;
  }
  @media (min-width: 900px) {
    .beat {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 0;
    }
  }
  .beat-orb {
    --orb: 44px;
    grid-row: span 4;
    position: relative;
    z-index: 1;
    box-shadow:
      0 0 0 5px var(--background),
      var(--shadow-bead);
  }
  .beat-when {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.2rem;
  }
  @media (min-width: 900px) {
    .beat-when {
      margin-top: 1.1rem;
      padding-top: 0;
    }
  }
  .beat-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.1875rem;
    color: var(--ink);
    margin-top: 0.35rem;
  }
  .beat-body {
    margin-top: 0.4rem;
    color: var(--ink-muted);
    line-height: 1.55;
    font-size: 0.9375rem;
    max-width: 22rem;
  }
  .beat-tag {
    margin-top: 0.75rem;
    justify-self: start;
  }
  @media (max-width: 899px) {
    .beat {
      padding-bottom: 1.35rem;
    }
    .beat-tag {
      display: none;
    }
  }

  /* Draw the thread as the section enters; resting style is fully drawn. */
  :global(.js-ready) .journey.reveal .journey-thread {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-standard) 0.1s;
  }
  :global(.js-ready) .journey.reveal .beat {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.42s var(--ease-out),
      transform 0.42s var(--ease-out);
    transition-delay: calc(0.1s + var(--i) * 90ms);
  }
  :global(.js-ready) .journey.reveal.is-visible .journey-thread {
    clip-path: inset(0 0 0 0);
  }
  :global(.js-ready) .journey.reveal.is-visible .beat {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 900px) {
    :global(.js-ready) .journey.reveal .journey-thread {
      clip-path: inset(0 100% 0 0);
    }
    :global(.js-ready) .journey.reveal.is-visible .journey-thread {
      clip-path: inset(0 0 0 0);
    }
  }
  /* The section wrapper is .reveal too; don't double-fade it. */
  :global(.js-ready) .journey.reveal {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-ready) .journey.reveal .journey-thread,
    :global(.js-ready) .journey.reveal .beat {
      clip-path: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
