---
import CoveyMark from "./CoveyMark.astro";
import { SITE } from "../config";

const cols = [
  {
    title: "Company",
    links: [
      { href: "/about", label: "About" },
      { href: "/testimonials", label: "Testimonials" },
      { href: "/events", label: "Upcoming events" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/support", label: "Support" },
    ],
  },
] as const;
---

<footer class="mt-[var(--section-y-tight)] border-t">
  <div class="max-w-7xl mx-auto px-6 py-14 grid md:grid-cols-12 gap-10 md:gap-12">
    <div class="md:col-span-5 space-y-5">
      <CoveyMark variant="full" dotSize={8} />
      <p class="text-sm text-ink-muted max-w-sm leading-relaxed">
        {SITE.tagline} Launching invite-only on iOS, {SITE.city.split(",")[0]} first.
      </p>
      <a
        href={`mailto:${SITE.emails.hello}`}
        class="inline-block font-mono text-xs uppercase tracking-[0.16em] text-ink-muted hover:text-ink transition-colors"
      >
        {SITE.emails.hello}
      </a>
    </div>

    {
      cols.map((c) => (
        <div class="md:col-span-2">
          <div class="eyebrow mb-4">{c.title}</div>
          <ul class="space-y-2.5 text-sm text-ink-muted">
            {c.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-ink transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="md:col-span-3">
      <div class="eyebrow mb-4">Follow</div>
      <a
        href={SITE.social.instagram}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-ink transition-colors"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
        Instagram
      </a>
    </div>
  </div>
  <div class="border-t">
    <div class="max-w-7xl mx-auto px-6 py-6 font-mono text-xs uppercase tracking-[0.16em] text-ink-muted flex justify-between flex-wrap gap-2">
      <span>{SITE.city}</span>
      <span>© {new Date().getFullYear()} {SITE.name} Co. · All rights reserved.</span>
    </div>
  </div>
</footer>
