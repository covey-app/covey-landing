---
import CoveyMark from "./CoveyMark.astro";
import { SITE } from "../config";

const cols: { title: string; links: { href: string; label: string }[] }[] = [
  {
    title: "Company",
    links: [
      { href: "/about", label: "About" },
      { href: "/testimonials", label: "Testimonials" },
      { href: "/events", label: "Upcoming events" },
      { href: "/contact", label: "Contact" },
      // The product is a separate deploy on app.coveyapp.co (covey-web repo).
      ...(SITE.appIsLive
        ? [
            { href: SITE.browseUrl, label: "Browse plans" },
            { href: SITE.appUrl, label: "Sign in" },
          ]
        : []),
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/support", label: "Support" },
    ],
  },
];
---

<footer class="mt-32 border-t">
  <div class="max-w-7xl mx-auto px-6 py-16 grid md:grid-cols-12 gap-12">
    <div class="md:col-span-6 space-y-5">
      <CoveyMark variant="full" dotSize={8} />
      <p class="text-sm text-ink-muted max-w-sm leading-relaxed">
        {SITE.tagline} Launching invite-only on iOS, {SITE.city.split(",")[0]} first.
      </p>
      <p class="font-mono text-xs text-ink-subtle max-w-sm leading-relaxed lowercase tracking-tight">
        covey /kuh-vee/ — a small flock of birds; a small group of people
        gathered together.
      </p>
      <a
        href={`mailto:${SITE.emails.hello}`}
        class="inline-block font-mono text-xs uppercase tracking-[0.16em] text-ink-muted hover:text-ink transition-colors"
      >
        {SITE.emails.hello}
      </a>
    </div>

    {
      cols.map((c) => (
        <div class="md:col-span-2">
          <div class="eyebrow mb-4">{c.title}</div>
          <ul class="space-y-2.5 text-sm text-ink-muted">
            {c.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-ink transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="md:col-span-2 flex md:justify-end items-start">
      <a
        href={SITE.social.instagram}
        target="_blank"
        rel="noreferrer"
        class="font-mono text-xs uppercase tracking-[0.16em] text-ink-muted hover:text-ink transition-colors"
      >
        Instagram
      </a>
    </div>
  </div>
  <div class="border-t">
    <div class="max-w-7xl mx-auto px-6 py-6 font-mono text-[10px] uppercase tracking-[0.2em] text-ink-subtle flex justify-between flex-wrap gap-2">
      <span>{SITE.city}</span>
      <span>© {new Date().getFullYear()} {SITE.name} Co. · All rights reserved.</span>
    </div>
  </div>
</footer>
