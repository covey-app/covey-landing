---
/*
 * Footer: a sign-off line set big, then the directory.
 */
import AppIcon from "./AppIcon.astro";
import { SITE, CITY_SHORT } from "../config";

const cols: { title: string; links: { href: string; label: string; external?: boolean }[] }[] = [
  {
    title: "Covey",
    links: [
      { href: "/", label: "Home" },
      { href: "/activities", label: "Activities" },
      { href: "/newsletter", label: "Newsletter" },
      { href: "/about", label: "About" },
      { href: SITE.waitlistPath, label: "Join the waitlist" },
      { href: SITE.signInUrl, label: "Sign in" },
    ],
  },
  {
    title: "Help",
    links: [
      { href: "/support", label: "Support" },
      { href: "/safety", label: "Safety" },
      { href: "/contact", label: "Contact" },
      { href: "/status", label: "Status" },
      { href: `mailto:${SITE.emails.press}`, label: "Press" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/terms", label: "Terms" },
      { href: "/privacy", label: "Privacy" },
      { href: "/deletion", label: "Account deletion" },
    ],
  },
];
---

<footer class="site-footer">

  <div class="wrap footer-top">
    <p class="signoff t-display">see you<br />out there.</p>
    <div class="footer-cols">
      {
        cols.map((c) => (
          <div>
            <h2 class="kicker no-rule mb-3">{c.title}</h2>
            <ul class="footer-list">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} class="footer-link">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="wrap footer-bottom">
    <a href="/" class="footer-brand" aria-label="Covey — home">
      <AppIcon size={26} />
      <span>covey</span>
    </a>
    <p class="footer-meta">
      Small-group plans, starting in {CITY_SHORT}. 18+.
      <a href={SITE.social.instagram} target="_blank" rel="noreferrer" class="footer-inline">Instagram<span class="sr-only"> (opens in a new tab)</span></a>
      <a href={`mailto:${SITE.emails.hello}`} class="footer-inline">{SITE.emails.hello}</a>
    </p>
    <p class="footer-meta">© {new Date().getFullYear()} {SITE.name} Co.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 0.7px solid var(--edge);
  }
  .footer-top {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 5rem) 2.5rem;
  }
  .signoff {
    color: var(--ink);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }
  .footer-link:hover {
    color: var(--ink);
  }
  @media (pointer: fine) {
    .footer-link {
      min-height: 32px;
    }
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 2rem;
    border-top: 0.7px solid var(--edge);
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.05em;
    color: var(--ink);
  }
  .footer-meta {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .footer-inline {
    margin-left: 0.75rem;
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in oklab, currentColor 35%, transparent);
  }
  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
    }
    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
