---
import AppIcon from "./AppIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../config";

// Section anchors resolve against the home page from any route. Testimonials
// and Events stay out of the nav until they hold real content (footer only).
const links = [
  { href: "/#how", label: "How it works" },
  { href: "/#coveys", label: "Coveys" },
  { href: "/#safety", label: "Safety" },
  { href: "/about", label: "About" },
];

// Normalize trailing slashes so /about and /about/ both mark the nav link.
const normalize = (p: string) => p.replace(/\/+$/, "") || "/";
const path = normalize(new URL(Astro.request.url).pathname);
const isCurrent = (href: string) => !href.includes("#") && normalize(href) === path;
---

<header
  data-header
  class="sticky top-0 z-40 vellum-panel border-b pt-[env(safe-area-inset-top,0px)]"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-3 sm:gap-4">
    <a href="/" class="brand flex items-center gap-2 shrink-0" aria-label="Covey — home">
      <AppIcon size={30} eager />
      <span class="font-mono font-semibold text-[1.35rem] tracking-[-0.03em] text-ink">Covey</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? "page" : undefined}
            class:list={["nav-link", isCurrent(l.href) && "is-current"]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href={SITE.signInUrl} class="sign-in">Sign in</a>
      <a href={SITE.joinUrl} class="btn btn-primary btn-sm header-cta">Join Covey</a>
      <button
        type="button"
        class="menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-btn
      >
        <svg class="icon-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu border-t" hidden data-menu-panel>
    <nav class="max-w-7xl mx-auto px-5 py-3 flex flex-col" aria-label="Mobile">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? "page" : undefined}
            class:list={["menu-link", isCurrent(l.href) ? "text-ink" : "text-ink-muted"]}
          >
            {l.label}
          </a>
        ))
      }
      <a href={SITE.signInUrl} class="menu-link text-ink-muted">Sign in</a>
      <a href={SITE.joinUrl} class="btn btn-primary btn-lg w-full mt-3 mb-2">Join Covey</a>
    </nav>
  </div>
</header>

<style>
  /*
   * Responsive visibility lives here, in scoped CSS, on purpose. Astro's
   * scoped styles are unlayered, and unlayered CSS beats Tailwind v4's
   * `@layer utilities` whatever the specificity — so `class="md:hidden"` on an
   * element whose scoped rule sets `display` silently never hides it. That is
   * how a dead hamburger shipped on desktop. Keep display + breakpoints
   * together in one place.
   */
  .brand {
    min-height: 44px;
  }
  .primary-nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    padding-block: 0.5rem;
    transition: color var(--motion-snappy);
  }
  .nav-link:hover,
  .nav-link.is-current {
    color: var(--ink);
  }
  .sign-in {
    display: none;
    align-items: center;
    min-height: 40px;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    transition: color var(--motion-snappy);
  }
  .sign-in:hover {
    color: var(--ink);
  }
  .header-cta {
    display: none;
  }

  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    border: 0.7px solid color-mix(in oklab, var(--edge) 65%, transparent);
    background-color: transparent;
    cursor: pointer;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  .menu-btn:hover {
    color: var(--ink);
    border-color: color-mix(in oklab, var(--ink) 25%, transparent);
  }
  .menu-btn svg {
    grid-area: 1 / 1;
  }
  .menu-btn .icon-close {
    display: none;
  }
  .menu-btn[aria-expanded="true"] .icon-open {
    display: none;
  }
  .menu-btn[aria-expanded="true"] .icon-close {
    display: block;
  }

  .menu-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 0.7px solid color-mix(in oklab, var(--edge) 45%, transparent);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @media (min-width: 640px) {
    .sign-in {
      display: inline-flex;
    }
    .header-cta {
      display: inline-flex;
    }
  }
  @media (min-width: 900px) {
    .primary-nav {
      display: flex;
    }
    .menu-btn,
    .mobile-menu {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-in 0.22s var(--ease-standard) both;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initMenu() {
    const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
    const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
    if (!btn || !panel || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    const setOpen = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
    };

    btn.addEventListener("click", () => {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });

    // Close on link tap, Escape (returning focus), or resize to desktop.
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        btn.focus();
      }
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 900) setOpen(false);
    });
  }

  initMenu();
  document.addEventListener("astro:page-load", initMenu);
</script>
