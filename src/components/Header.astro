---
import CoveyMark from "./CoveyMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../config";

const links = [
  { href: "/about", label: "About" },
  { href: "/testimonials", label: "Testimonials" },
  { href: "/events", label: "Events" },
  { href: "/contact", label: "Contact" },
];

const path = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-40 vellum-panel border-b">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="Covey — home">
      <CoveyMark variant="dots" dotSize={7} class="group-hover:opacity-90 transition-opacity" />
      <span class="font-mono font-semibold text-[1.35rem] tracking-[-0.03em] text-ink">Covey</span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? "page" : undefined}
            class:list={[
              "font-mono text-xs uppercase tracking-[0.14em] transition-colors",
              path === l.href ? "text-ink" : "text-ink-muted hover:text-ink",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      {
        /* The product lives on app.coveyapp.co; the waitlist stays here.
           Browsing plans needs no account, so it leads the sign-in link. */
        SITE.appIsLive && (
          <>
            <a
              href={SITE.browseUrl}
              class="hidden sm:inline-flex font-mono text-xs uppercase tracking-[0.14em] text-ink-muted hover:text-ink transition-colors"
            >
              Browse plans
            </a>
            <a
              href={SITE.appUrl}
              class="hidden sm:inline-flex font-mono text-xs uppercase tracking-[0.14em] text-ink-muted hover:text-ink transition-colors"
            >
              Sign in
            </a>
          </>
        )
      }
      <a
        href="/signup"
        class="btn btn-primary px-4 py-2.5 text-[0.65rem]"
      >
        Join the flock
      </a>
    </div>
  </div>

  <nav
    class="md:hidden border-t overflow-x-auto no-scrollbar"
    aria-label="Primary mobile"
  >
    <div class="flex gap-6 px-6 py-3 whitespace-nowrap">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? "page" : undefined}
            class:list={[
              "font-mono text-xs uppercase tracking-[0.14em]",
              path === l.href ? "text-ink" : "text-ink-muted",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
