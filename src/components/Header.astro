---
import { SITE } from "../config";

const links = [
  { href: "/about", label: "About" },
  { href: "/testimonials", label: "Testimonials" },
  { href: "/events", label: "Events" },
  { href: "/contact", label: "Contact" },
];

const path = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-40 vellum-panel border-b border-edge/60">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <img
        src="/images/bird-mark.png"
        alt=""
        class="bird-icon w-6 h-6 object-contain group-hover:animate-drift"
        style="--drift-rotate: -6deg"
      />
      <span class="font-serif italic text-2xl tracking-tight text-ink">{SITE.name}</span>
      <span class="eyebrow hidden sm:inline">Coming to iOS</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "font-medium transition-colors",
              path === l.href ? "text-ink" : "text-warm-gray hover:text-ink",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/signup"
      class="inline-flex items-center gap-2 bg-ink text-paper px-4 py-2 text-xs uppercase tracking-[0.18em] font-medium hover:bg-clay transition-colors duration-300"
    >
      Join the waitlist
    </a>
  </div>

  <nav class="md:hidden border-t border-edge/60 overflow-x-auto no-scrollbar">
    <div class="flex gap-6 px-6 py-3 whitespace-nowrap text-sm">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[path === l.href ? "text-ink" : "text-warm-gray"]}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
