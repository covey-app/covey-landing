---
/*
 * The Meadow art behind a `.meadow` section (styles/meadow.css): the lawn,
 * the shade bands that drift faster than it, and the lift that keeps words
 * legible. Put it first inside a section with position: relative.
 *
 * `fadeTop` / `fadeBottom` take the neighbouring section's ground colour
 * (a CSS colour or var). The lawn then dissolves into it through frosted
 * glass: the blur ramps in first, then the colour, so the seam reads as the
 * lawn passing under a frosted pane rather than a hard edge.
 *
 * Motion lives in lib/motion.ts ([data-meadow]): while the section is near
 * the screen, the lawn drifts at 0.35× scroll and the bands at 1.3× that,
 * both written as transforms. Reduced motion holds both still.
 */
interface Props {
  fadeTop?: string;
  fadeBottom?: string;
}
const { fadeTop, fadeBottom } = Astro.props;
---

<div class="meadow-ground" aria-hidden="true" data-meadow>
  <i class="meadow-lawn"></i>
  <i class="meadow-bands"></i>
  <i class="meadow-lift"></i>
  {fadeTop && <i class="meadow-fade meadow-fade--top" style={`--fade:${fadeTop}`}></i>}
  {fadeBottom && <i class="meadow-fade meadow-fade--bottom" style={`--fade:${fadeBottom}`}></i>}
</div>
