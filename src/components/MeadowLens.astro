---
/*
 * The Meadow liquid-glass edge lens, inlined once per page. Referenced from
 * --glass-backdrop-lens in styles/meadow.css as url(#covey-liquid-glass),
 * Chromium only (html[data-liquid-glass], set in BaseLayout).
 *
 * A smooth displacement map stretched over each glass box: red ramps 1 → 0.5
 * (neutral) → 0 across x, green the same down y, steepest at the edges like
 * the curve of a thick lens. Edge pixels sample the lawn from further inside
 * the card; the middle stays clear. Scale 0.14 of the box (0.26 stretched
 * flowers into card titles). Never use feTurbulence here: it dithers the rim.
 * Identical to covey-web's app/+html.tsx.
 */
---

<svg aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <filter id="covey-liquid-glass" x="0" y="0" width="1" height="1" primitiveUnits="objectBoundingBox" color-interpolation-filters="sRGB">
      <feImage href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%20preserveAspectRatio%3D%22none%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22x%22%20x1%3D%220%22%20x2%3D%221%22%20y1%3D%220%22%20y2%3D%220%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23ff0000%22%2F%3E%3Cstop%20offset%3D%220.035%22%20stop-color%3D%22%23d00000%22%2F%3E%3Cstop%20offset%3D%220.13%22%20stop-color%3D%22%23800000%22%2F%3E%3Cstop%20offset%3D%220.87%22%20stop-color%3D%22%23800000%22%2F%3E%3Cstop%20offset%3D%220.965%22%20stop-color%3D%22%23300000%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23000000%22%2F%3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%22y%22%20x1%3D%220%22%20x2%3D%220%22%20y1%3D%220%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%2300ff00%22%2F%3E%3Cstop%20offset%3D%220.05%22%20stop-color%3D%22%2300d000%22%2F%3E%3Cstop%20offset%3D%220.2%22%20stop-color%3D%22%23008000%22%2F%3E%3Cstop%20offset%3D%220.8%22%20stop-color%3D%22%23008000%22%2F%3E%3Cstop%20offset%3D%220.95%22%20stop-color%3D%22%23003000%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23000000%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22100%22%20height%3D%22100%22%20fill%3D%22url(%23x)%22%2F%3E%3Crect%20width%3D%22100%22%20height%3D%22100%22%20fill%3D%22url(%23y)%22%20style%3D%22mix-blend-mode%3Ascreen%22%2F%3E%3C%2Fsvg%3E" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="lens"/>
      <feDisplacementMap in="SourceGraphic" in2="lens" scale="0.14" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </defs>
</svg>
