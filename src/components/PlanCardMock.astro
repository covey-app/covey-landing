---
/*
 * PlanCardMock — a static, marketing-only rendition of the app's plan card
 * (PlanCardView.swift), adapted as a web composition rather than a raw app
 * screenshot. Faithful to the real structure: a status-badge row, the
 * title-forward hero line, a row of category "stop orbs", and the
 * date · time · city · stops meta line, closing on the host + going count.
 */
type Tone = "neutral" | "ink" | "accent" | "moss" | "slate" | "rose" | "clay";
interface Plan {
  hangout: { label: string; tone: Tone };
  join: { label: string; tone: Tone };
  title: string;
  /** Category CSS-var keys for the stop orbs. */
  stops: string[];
  date: string;
  time: string;
  city: string;
  host: string;
  going: string;
  class?: string;
  rotate?: number;
}
const {
  hangout,
  join,
  title,
  stops,
  date,
  time,
  city,
  host,
  going,
  class: className = "",
  rotate = 0,
} = Astro.props as Plan;

const initials = host
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .join("");

const toneClass: Record<Tone, string> = {
  neutral: "badge-neutral",
  ink: "badge-ink",
  accent: "badge-accent",
  moss: "badge-moss",
  slate: "badge-slate",
  rose: "badge-rose",
  clay: "badge-clay",
};
const meta = [date, time, city, `${stops.length} stops`].filter(Boolean);
---

<article
  class:list={["plan-card card", className]}
  style={rotate ? `transform: rotate(${rotate}deg)` : undefined}
>
  <div class="plan-row">
    <span class:list={["badge", toneClass[hangout.tone]]}>{hangout.label}</span>
    <span class:list={["badge", toneClass[join.tone]]}>{join.label}</span>
    <span class="plan-going">{going}</span>
  </div>

  <h3 class="plan-title title-mono">{title}</h3>

  <div class="plan-orbs" aria-hidden="true">
    {stops.map((key, i) => (
      <span class="plan-orb" style={`background-color: var(--cat-${key}); --i:${i}`}>
        <span class="plan-orb-num">{i + 1}</span>
      </span>
    ))}
  </div>

  <div class="plan-meta">
    {meta.map((m, i) => (
      <>
        {i > 0 && <span class="plan-dot"></span>}
        <span>{m}</span>
      </>
    ))}
  </div>

  <div class="plan-footer">
    <span class="plan-avatar">{initials}</span>
    <span class="plan-host">Hosted by {host}</span>
  </div>
</article>

<style>
  .plan-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    width: 100%;
    max-width: 22rem;
  }
  .plan-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .plan-going {
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    white-space: nowrap;
  }
  .plan-title {
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--ink);
    margin: 0;
  }
  .plan-orbs {
    display: flex;
    gap: 0.4rem;
  }
  .plan-orb {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    box-shadow: var(--shadow-bead);
    display: grid;
    place-items: center;
  }
  .plan-orb-num {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.92);
  }
  .plan-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .plan-dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background-color: color-mix(in oklab, var(--ink-subtle) 60%, transparent);
  }
  .plan-footer {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding-top: 0.75rem;
    border-top: 0.7px solid color-mix(in oklab, var(--edge) 60%, transparent);
  }
  .plan-avatar {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background-color: var(--cat-outdoors-soft);
    color: var(--cat-outdoors-ink);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
  }
  .plan-host {
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
</style>
