---
/*
 * Headings: the card is a labeled <article>, and its title/stops are <p> so
 * the example plan doesn't enter the page outline ahead of the real sections.
 *
 * PlanInvite — the web translation of the app's plan cover
 * (BrochureOpeningCover in covey-ios PlanDetail/BrochureFold.swift): a paper
 * invitation with a "COVEY · THE PLAN" masthead, the plan title, a meta line,
 * a hairline, the stops joined by a dashed thread, "HOSTED BY", and an ink
 * tag. The masthead reads "EXAMPLE PLAN" here so nobody mistakes it for a
 * real listing.
 *
 * Motion (the page's one signature moment): the card rises, then each stop
 * arrives in order — orb pops, text settles, the thread draws down to the
 * next stop — then the seats fill. CSS only, ≤ 1.1s, and every element's
 * resting style is its final state, so reduced motion (global rule) or a
 * failed animation still shows the whole card.
 */
import Icon from "./Icon.astro";
import type { ExamplePlan } from "../lib/plans";
import { goingLabel } from "../lib/plans";

interface Props {
  plan: ExamplePlan;
  href?: string;
  class?: string;
}
const { plan, href = "#how", class: className } = Astro.props;
const open = plan.seats - plan.people.length;
---

<article class:list={["invite", className]} aria-label={`Example plan: ${plan.title}`}>
  <div class="invite-sheet">
    <header class="invite-mast" style="--s:0">
      <span>Covey</span>
      <span>Example plan</span>
    </header>

    <p class="invite-title" style="--s:1">{plan.title}</p>
    <p class="meta-line invite-meta" style="--s:2">
      <span>{plan.day}</span><span>{plan.timeRange}</span><span>{plan.area}</span>
    </p>

    <div class="invite-orbs" aria-hidden="true">
      {plan.stops.map((s) => (
        <span class="orb" style={`--orb:30px; --c:var(--cat-${s.category})`}>
          <Icon name={s.icon} />
        </span>
      ))}
      <span class="invite-orbs-count">{plan.stops.length} stops</span>
    </div>

    <hr class="invite-rule" />

    <ol class="invite-stops">
      {
        plan.stops.map((s, i) => (
          <li class="invite-stop" style={`--i:${i}; --c:var(--cat-${s.category}); --c-soft:var(--cat-${s.category}-soft); --c-ink:var(--cat-${s.category}-ink)`}>
            <span class="invite-rail" aria-hidden="true">
              <span class="orb invite-orb">
                <Icon name={s.icon} />
              </span>
            </span>
            <div class="invite-stop-body">
              <p class="invite-stop-title">{s.title}</p>
              <p class="invite-stop-time">
                {s.time}
                <span class="act-chip">{s.activity}</span>
              </p>
              <p class="invite-stop-venue">
                <Icon name="map-pin" size={13} />
                {s.venue}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <footer class="invite-foot">
      <div class="invite-host">
        <span class="eyebrow">Hosted by</span>
        <span class="invite-host-name">{plan.host.name}</span>
      </div>
      <div class="invite-seats" role="img" aria-label={`${plan.people.length} of ${plan.seats} seats taken, ${open} open`}>
        <span class="invite-dots" aria-hidden="true">
          {Array.from({ length: plan.seats }, (_, j) => (
            <span class:list={["seat", j < plan.people.length && "is-taken"]} style={`--j:${j}`} />
          ))}
        </span>
        <span class="invite-going" aria-hidden="true">{goingLabel(plan)}</span>
      </div>
    </footer>

    <a href={href} class="invite-open">
      <Icon name="hand" size={14} />
      Open the plan
    </a>
  </div>
</article>

<style>
  .invite {
    position: relative;
    width: 100%;
    max-width: 27.5rem;
  }
  /* A second page peeking behind — the brochure's inside sheet. */
  .invite::before {
    content: "";
    position: absolute;
    inset: 0.75rem -0.5rem -0.75rem 0.75rem;
    border-radius: var(--radius-sheet);
    background-color: var(--paper-elevated);
    border: 0.7px solid color-mix(in oklab, var(--edge) 70%, transparent);
    box-shadow: var(--shadow-paper);
    transform: rotate(3deg);
    opacity: 0.7;
  }
  .invite-sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.35rem;
    border-radius: var(--radius-sheet);
    background-color: var(--paper-elevated);
    border: 0.7px solid color-mix(in oklab, var(--edge) 55%, transparent);
    box-shadow: var(--shadow-pinned);
  }
  @media (min-width: 640px) {
    .invite-sheet {
      padding: 2rem 2rem 1.6rem;
    }
  }

  .invite-mast {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 1rem;
  }

  /* PlanTitle xl — Geist Mono Medium; user content, so not lowercased. */
  .invite-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.55rem, 1.2vw + 1.2rem, 2rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }
  .invite-rule {
    border: 0;
    border-top: 0.7px solid var(--edge);
    margin: 1.1rem 0 1.25rem;
  }

  .invite-stops {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .invite-stop {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 0.85rem;
  }
  .invite-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .invite-orb {
    --orb: 32px;
    position: relative;
    z-index: 1;
  }
  /* The dashed thread (TimelineThread cover style: 1.5pt, dash 3/4). */
  .invite-stop:not(:last-child) .invite-rail::after {
    content: "";
    position: absolute;
    top: 36px;
    bottom: calc(-1.1rem - 4px);
    left: calc(50% - 0.75px);
    border-left: 1.5px dashed color-mix(in oklab, var(--ink-subtle) 70%, transparent);
  }
  .invite-stop-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.25;
    color: var(--ink);
    padding-top: 0.2rem;
  }
  .invite-stop-time {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
  .invite-stop-time .act-chip {
    font-size: 0.6875rem;
    padding: 0.2rem 0.5rem;
  }
  .invite-stop-venue {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .invite-stop-venue :global(svg) {
    color: var(--ink-subtle);
    flex: none;
  }

  .invite-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 0.7px solid var(--edge);
  }
  .invite-host {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .invite-host-name {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .invite-seats {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .invite-dots {
    display: flex;
    gap: 4px;
  }
  .seat {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 1.2px solid color-mix(in oklab, var(--ink-subtle) 80%, transparent);
  }
  .seat.is-taken {
    border-color: transparent;
    background-color: var(--accent);
  }
  .invite-going {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--accent);
  }

  /* The "TAP TO OPEN" tag, as a real link into the demo below. */
  .invite-open {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin-top: 1.1rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-sm);
    background-color: var(--ink);
    color: var(--ink-inverse);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      transform var(--motion-snappy),
      box-shadow var(--motion-snappy);
  }
  .invite-open:hover {
    box-shadow: var(--shadow-pinned);
  }
  .invite-open:active {
    transform: scale(0.97);
  }

  @media (min-width: 1024px) {
    .invite {
      transform: rotate(-1.2deg);
    }
  }

  /*
   * Phones: the feed-card form (the app's PlanCardView — title, stop orbs,
   * meta, going). The full itinerary is one scroll away in the demo, so the
   * hero doesn't repeat it; "Open the plan" goes there, like tapping a card in
   * the app. The stop list is hidden for everyone (not just visually): the
   * demo already presents it in full, so it isn't announced twice.
   */
  .invite-orbs {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .invite-orbs-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    margin-left: 0.25rem;
  }
  @media (max-width: 639px) {
    .invite::before,
    .invite-rule,
    .invite-stops {
      display: none;
    }
    .invite-orbs {
      display: flex;
    }
    .invite-foot {
      margin-top: 1.1rem;
    }
  }

  /* ---- Choreography (no-preference only; resting styles are final) ---- */
  @media (prefers-reduced-motion: no-preference) {
    .invite-sheet {
      animation: inv-rise 0.52s var(--ease-out) both;
    }
    .invite::before {
      animation: inv-fade 0.6s var(--ease-out) 0.12s both;
    }
    .invite-mast,
    .invite-title,
    .invite-meta {
      animation: inv-settle 0.42s var(--ease-out) both;
      animation-delay: calc(0.12s + var(--s) * 0.06s);
    }
    .invite-rule {
      transform-origin: left;
      animation: inv-rule 0.5s var(--ease-out) 0.26s both;
    }
    .invite-orb {
      animation: inv-pop 0.42s var(--ease-pop) both;
      animation-delay: calc(0.32s + var(--i) * 0.11s);
    }
    .invite-stop-body {
      animation: inv-settle 0.38s var(--ease-out) both;
      animation-delay: calc(0.36s + var(--i) * 0.11s);
    }
    .invite-stop:not(:last-child) .invite-rail::after {
      animation: inv-thread 0.3s var(--ease-standard) both;
      animation-delay: calc(0.44s + var(--i) * 0.11s);
    }
    .seat.is-taken {
      animation: inv-pop 0.3s var(--ease-pop) both;
      animation-delay: calc(0.72s + var(--j) * 0.06s);
    }
    .invite-foot,
    .invite-open {
      animation: inv-settle 0.4s var(--ease-out) 0.66s both;
    }
  }
  @keyframes inv-rise {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.985);
    }
  }
  @keyframes inv-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes inv-settle {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes inv-rule {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes inv-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }
  @keyframes inv-thread {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
