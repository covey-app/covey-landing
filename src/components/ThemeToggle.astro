---
/*
 * ThemeToggle — light/dark switch. The initial theme is applied pre-paint by
 * an inline script in BaseLayout (no flash of the wrong theme); this button
 * toggles the `.dark` class on <html>, persists the choice, and exposes the
 * current state via aria-pressed + a dynamic label.
 */
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Switch to dark mode"
  aria-pressed="false"
  title="Toggle theme"
  data-theme-toggle
>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    border: 0.7px solid color-mix(in oklab, var(--edge) 65%, transparent);
    background-color: transparent;
    cursor: pointer;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform var(--motion-snappy);
  }
  .theme-toggle:hover {
    color: var(--ink);
    background-color: color-mix(in oklab, var(--ink) 5%, transparent);
    border-color: color-mix(in oklab, var(--ink) 25%, transparent);
  }
  .theme-toggle:active {
    transform: scale(0.94);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .icon-moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }
  .icon-sun {
    opacity: 1;
  }
  :global(.dark) .icon-sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }
  :global(.dark) .icon-moon {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    try {
      localStorage.setItem("covey-theme", dark ? "dark" : "light");
    } catch (e) {
      /* storage unavailable — ignore */
    }
    // Explicit theme-color (no media query) so iOS Safari chrome follows the
    // manual toggle instead of only system prefers-color-scheme.
    let meta = document.querySelector(
      'meta[name="theme-color"]:not([media])',
    ) as HTMLMetaElement | null;
    if (!meta) {
      meta = document.createElement("meta");
      meta.setAttribute("name", "theme-color");
      document.head.appendChild(meta);
    }
    meta.setAttribute("content", dark ? "#0e0e10" : "#f4f4f4");
    syncButtons();
  }

  function syncButtons() {
    const dark = document.documentElement.classList.contains("dark");
    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      .forEach((btn) => {
        btn.setAttribute("aria-pressed", String(dark));
        btn.setAttribute(
          "aria-label",
          dark ? "Switch to light mode" : "Switch to dark mode",
        );
      });
  }

  function initToggles() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
    buttons.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        applyTheme(!document.documentElement.classList.contains("dark"));
      });
    });
    syncButtons();
  }

  initToggles();
  document.addEventListener("astro:after-swap", syncButtons);
  document.addEventListener("astro:page-load", initToggles);
</script>
