---
/*
 * ThemeToggle — light/dark switch. Theme application + view-transition
 * persistence live in BaseLayout's inline script; this button only fires
 * a click that toggles `.dark` on <html> and syncs its ARIA state.
 */
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Switch to dark mode"
  aria-pressed="false"
  title="Toggle theme"
  data-theme-toggle
>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    border: 0.7px solid color-mix(in oklab, var(--edge) 65%, transparent);
    background-color: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform var(--motion-snappy);
  }
  .theme-toggle:hover {
    color: var(--ink);
    background-color: color-mix(in oklab, var(--ink) 5%, transparent);
    border-color: color-mix(in oklab, var(--ink) 25%, transparent);
  }
  .theme-toggle:active {
    transform: scale(0.94);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .icon-moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }
  .icon-sun {
    opacity: 1;
  }
  :global(html.dark) .icon-sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }
  :global(html.dark) .icon-moon {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  function syncButtons() {
    const dark = document.documentElement.classList.contains("dark");
    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      .forEach((btn) => {
        btn.setAttribute("aria-pressed", String(dark));
        btn.setAttribute(
          "aria-label",
          dark ? "Switch to light mode" : "Switch to dark mode",
        );
      });
  }

  function setThemeColor(dark: boolean) {
    let meta = document.querySelector(
      'meta[name="theme-color"]:not([media])',
    ) as HTMLMetaElement | null;
    if (!meta) {
      meta = document.createElement("meta");
      meta.setAttribute("name", "theme-color");
      document.head.appendChild(meta);
    }
    meta.setAttribute("content", dark ? "#0e0e10" : "#f4f4f4");
  }

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    try {
      localStorage.setItem("covey-theme", dark ? "dark" : "light");
    } catch {
      /* storage unavailable */
    }
    setThemeColor(dark);
    syncButtons();
  }

  // Document-level delegation survives Header transition:persist + soft nav.
  const w = window as unknown as { __coveyThemeClick?: boolean };
  if (!w.__coveyThemeClick) {
    w.__coveyThemeClick = true;
    document.addEventListener(
      "click",
      (e) => {
        const target = e.target as Element | null;
        if (!target?.closest?.("[data-theme-toggle]")) return;
        e.preventDefault();
        applyTheme(!document.documentElement.classList.contains("dark"));
      },
      true,
    );
  }

  syncButtons();
  document.addEventListener("astro:page-load", syncButtons);
  document.addEventListener("astro:after-swap", syncButtons);
</script>
