---
import CoveyMark from "./CoveyMark.astro";

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
}
const {
  eyebrow = "Ready when you are",
  heading = "Be first in the flock.",
  body = "We're rolling out invite-only on iOS, starting in San Francisco. Drop your email and we'll reach out the second a spot opens up.",
} = Astro.props;
---

<section class="max-w-4xl mx-auto px-6 py-[var(--section-y)] text-center border-t reveal">
  <div class="flex justify-center mb-6">
    <CoveyMark variant="dots" dotSize={9} />
  </div>
  <span class="eyebrow block mb-4">{eyebrow}</span>
  <h2 class="display t-h2 mb-6">{heading}</h2>
  <p class="text-ink-muted max-w-xl mx-auto mb-10 leading-relaxed">{body}</p>
  <div class="flex justify-center gap-3 flex-wrap">
    <a href="/signup" class="btn btn-primary btn-lg">Join the flock</a>
    <a href="/contact" class="btn btn-secondary btn-lg">Talk to us</a>
  </div>
</section>
