---
// Brand-story section — product metaphor only.
// The dictionary definition lives once in the hero (DefinitionMoment).
import CoveyMark from "./CoveyMark.astro";
---

<section id="why-covey" class="max-w-6xl mx-auto px-4 sm:px-6 py-[var(--section-y)] grid md:grid-cols-12 gap-8 md:gap-10 lg:gap-12 items-center reveal scroll-mt-28">
  <div class="md:col-span-5">
    <div class="card-pinned p-7 sm:p-8 flex flex-col items-start gap-5" style="border-radius: var(--radius-sheet)">
      <CoveyMark variant="dots" dotSize={9} />
      <div>
        <div class="font-mono font-semibold text-2xl sm:text-3xl tracking-[-0.03em] text-ink lowercase mb-2">covey</div>
        <p class="font-mono text-sm text-ink-muted tracking-[0.04em] leading-relaxed">
          Ten to fifteen. Never a crowd.
        </p>
      </div>
    </div>
  </div>

  <div class="md:col-span-7">
    <div class="eyebrow mb-3">Why the name fits</div>
    <h2 class="display t-h2 mb-5 sm:mb-6 text-balance">
      Birds don't flock in crowds.
    </h2>
    <p class="text-ink-muted leading-relaxed text-[1.0625rem] sm:text-lg mb-4 sm:mb-5">
      Quail move in small groups — they watch out for each other, then scatter
      back to their own lives when the day is done.
    </p>
    <p class="text-ink-muted leading-relaxed text-[1.0625rem] sm:text-lg">
      That's the whole app in one word. Not a crowd, not a feed — a small
      group of people, gathered around one plan, for one day.
    </p>
  </div>
</section>
