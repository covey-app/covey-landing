---
/*
 * EditionGuide — the complete guide as an edition prints it: by day, then by
 * part of the day, every listing with its full detail (address, price,
 * summary, "know before you go" tips, and every link we have). /activities
 * shows the same listings as compact, filterable rows; this is the version
 * you read.
 */
import Icon from "../Icon.astro";
import { CATEGORIES, TAG_LABELS } from "../../lib/categories";
import { longDate, partsOfDay, priceLabel, timeLabel, type GuideDay } from "../../lib/guide";

interface Props {
  days: GuideDay[];
  pickIds?: string[];
  id: string;
}
const { days, pickIds = [], id } = Astro.props;
const filled = days.filter((d) => d.items.length);
---

<div class="eg" id={id}>
  {
    filled.length > 1 && (
      <nav class="eg-jump" aria-label="Jump to a day">
        {filled.map((d) => (
          <a href={`#${id}-${d.date}`}>
            {longDate(d.date).split(",")[0]} <span>{d.items.length}</span>
          </a>
        ))}
      </nav>
    )
  }
  {
    filled.map((d) => (
      <section class="eg-day" aria-labelledby={`${id}-${d.date}`}>
        <h3 class="eg-day-title" id={`${id}-${d.date}`}>
          <span>{longDate(d.date).split(",")[0].toLowerCase()}</span>
          <span class="eg-day-date">
            {longDate(d.date).split(", ")[1]} · {d.items.length} things
          </span>
        </h3>
        {partsOfDay(d.items).map((part) => (
          <div class="eg-part">
            <h4 class="eg-part-title">{part.label}</h4>
            <ul class="eg-list">
              {part.items.map((it) => {
                const a = it.data;
                const price = priceLabel(a);
                return (
                  <li class="eg-item" id={`${id}-${d.date}-${it.id}`} style={`--c:var(--cat-${a.category})`}>
                    <p class="eg-time">{timeLabel(a) ?? "Any time"}</p>
                    <div class="eg-main">
                      <p class="eg-kicker">
                        <span class="orb" style="--orb:1.35rem" aria-hidden="true">
                          <Icon name={CATEGORIES[a.category].icon} />
                        </span>
                        {a.activity ?? CATEGORIES[a.category].short}
                        {pickIds.includes(it.id) && <span class="eg-pick">Top pick</span>}
                      </p>
                      <h5 class="eg-title">
                        <a href={a.source.url} target="_blank" rel="noopener">
                          {a.title}
                          <span class="sr-only"> (opens the organizer's page)</span>
                        </a>
                      </h5>
                      <p class="eg-summary">{a.summary}</p>
                      <dl class="eg-facts">
                        <div>
                          <dt>Where</dt>
                          <dd>{`${a.venue}${a.address ? `, ${a.address}` : ""} · ${a.neighborhood}`}</dd>
                        </div>
                        <div>
                          <dt>Cost</dt>
                          <dd>{price ?? "Not listed"}</dd>
                        </div>
                        {a.endDate && a.date && (
                          <div>
                            <dt>Runs</dt>
                            <dd>
                              {longDate(a.date)} – {longDate(a.endDate)}
                            </dd>
                          </div>
                        )}
                      </dl>
                      {a.tips.length > 0 && (
                        <ul class="eg-tips" aria-label="Know before you go">
                          {a.tips.map((t) => (
                            <li>
                              <Icon name="info" size={14} />
                              {t}
                            </li>
                          ))}
                        </ul>
                      )}
                      <p class="eg-links">
                        <a href={a.source.url} target="_blank" rel="noopener">
                          {a.source.name}
                          <Icon name="external-link" size={12} />
                        </a>
                        {a.links.map((l) => (
                          <a href={l.url} target="_blank" rel="noopener">
                            {l.name}
                            <Icon name="external-link" size={12} />
                          </a>
                        ))}
                        {a.tags
                          .filter((t) => t !== "weekend")
                          .map((t) => (
                            <span class="eg-tag">{TAG_LABELS[t]}</span>
                          ))}
                      </p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
</div>

<style>
  .eg-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .eg-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    padding: 0 0.95rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
    background: var(--paper-elevated);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
  }
  .eg-jump span {
    color: var(--ink-muted);
  }
  .eg-day {
    margin-top: 2.5rem;
    scroll-margin-top: 5rem;
  }
  .eg-day-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 3px solid var(--ink);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.06em;
    color: var(--ink);
  }
  .eg-day-date {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-muted);
  }
  .eg-part {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.5rem;
  }
  .eg-part-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .eg-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .eg-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding: 1.25rem 0;
    border-bottom: 0.7px solid var(--edge);
    scroll-margin-top: 5rem;
  }
  .eg-item:target {
    background: linear-gradient(90deg, color-mix(in oklab, var(--accent) 10%, transparent), transparent 70%);
  }
  .eg-time {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }
  .eg-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .eg-pick {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ink-inverse);
    font-size: 0.6875rem;
  }
  .eg-title {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .eg-title a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease;
  }
  .eg-title a:hover {
    text-decoration-color: currentColor;
  }
  .eg-summary {
    margin-top: 0.35rem;
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .eg-facts {
    display: grid;
    gap: 0.2rem;
    margin: 0.6rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .eg-facts div {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0.5rem;
  }
  .eg-facts dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 0.1rem;
  }
  .eg-facts dd {
    margin: 0;
    color: var(--ink);
  }
  .eg-tips {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0.7rem 0.9rem;
    display: grid;
    gap: 0.35rem;
    max-width: 40rem;
    border-radius: 0.85rem;
    background: var(--cat-arts-soft);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .eg-tips li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
  }
  .eg-tips :global(svg) {
    margin-top: 0.2rem;
    color: var(--cat-arts-ink);
  }
  .eg-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
  .eg-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 32px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent);
    text-underline-offset: 0.2em;
  }
  .eg-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 0.7px solid var(--edge);
  }
  @media (min-width: 768px) {
    .eg-item {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1.25rem;
    }
    .eg-time {
      padding-top: 0.1rem;
    }
  }
</style>
