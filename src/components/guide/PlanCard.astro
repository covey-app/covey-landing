---
/*
 * PlanCard — one of an edition's ready-made plans, drawn like a plan in the
 * app: a title, who it's for, and its stops on a dotted route, each with the
 * category bead (CategoryStopBead), time, place, and price.
 */
import Icon from "../Icon.astro";
import { CATEGORIES } from "../../lib/categories";
import { dayName, priceLabel, timeLabel, type EditionPlan } from "../../lib/guide";

interface Props {
  plan: EditionPlan;
  n: number;
}
const { plan, n } = Astro.props;
const days = [...new Set(plan.stops.map((s) => s.data.date).filter(Boolean))] as string[];
const free = plan.stops.every((s) => s.data.priceMin === 0);
---

<article class="plan" aria-labelledby={`plan-${n}`}>
  <header class="plan-head">
    <p class="plan-meta">
      <span class="plan-for">{plan.for}</span>
      {days.length > 0 && <span>{days.map((d) => dayName(d)).join(" & ")}</span>}
      <span>{plan.stops.length} stops</span>
      {free && <span>All free</span>}
    </p>
    <h3 id={`plan-${n}`} class="plan-title">{plan.title.toLowerCase()}</h3>
    <p class="plan-note">{plan.note}</p>
  </header>
  <ol class="plan-stops">
    {
      plan.stops.map((s) => {
        const a = s.data;
        return (
          <li class="stop" style={`--c:var(--cat-${a.category})`}>
            <span class="orb" style="--orb:2rem" aria-hidden="true">
              <Icon name={CATEGORIES[a.category].icon} />
            </span>
            <div class="stop-body">
              <p class="stop-time">{timeLabel(a) ?? "Any time"}</p>
              <p class="stop-title">
                <a href={a.source.url} target="_blank" rel="noopener">
                  {a.title}
                  <span class="sr-only"> (opens the organizer's page)</span>
                </a>
              </p>
              <p class="stop-where">
                {a.venue}, {a.neighborhood}
                {priceLabel(a) && <> · {priceLabel(a)}</>}
              </p>
            </div>
          </li>
        );
      })
    }
  </ol>
</article>

<style>
  .plan {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding: 1.4rem 1.35rem 1.5rem;
    border-radius: 1.5rem;
    background: var(--paper-elevated);
    border: 0.7px solid color-mix(in oklab, var(--edge) 80%, transparent);
    box-shadow: var(--shadow-paper);
  }
  .plan-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .plan-for {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ink-inverse);
    letter-spacing: 0.04em;
  }
  .plan-title {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .plan-note {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .plan-stops {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.85rem;
  }
  /* The route: a dotted line from bead to bead, as on a plan in the app. */
  .stop:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(1rem - 1px);
    top: 2.25rem;
    bottom: -0.85rem;
    border-left: 2px dotted color-mix(in oklab, var(--ink) 28%, transparent);
  }
  .stop-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .stop-title {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .stop-title a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease;
  }
  .stop-title a:hover {
    text-decoration-color: currentColor;
  }
  .stop-where {
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
</style>
