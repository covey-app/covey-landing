---
/*
 * How it works — three steps, told on the real iOS app. On wide screens a
 * phone stands on a panel of Meadow lawn, pinned while the steps scroll
 * past, and the step in the middle of the viewport picks its screen. On
 * phones each step is a swipe card carrying its own screen, cropped.
 */
import Phone from "../Phone.astro";
import MeadowGround from "../MeadowGround.astro";
import Icon from "../Icon.astro";
import type { AppScreen } from "../../lib/app-screens";

const steps = [
  {
    n: "01",
    screen: "explore",
    t: "find a plan worth leaving the house for.",
    d: "Browse small plans around the city — a run then coffee, a ramen crawl, a sunset walk — or post your own in a few taps. You see exactly where, when, and who's going.",
  },
  {
    n: "02",
    screen: "plan",
    t: "take one of a few seats.",
    d: "Hosts set the headcount, six by default, so everyone actually talks. Open plans take one tap; request-to-join plans go to the host first.",
  },
  {
    n: "03",
    screen: "chat",
    t: "then do it again.",
    d: "When a group clicks, make it a Covey: a standing group with a recurring plan, so the second hangout doesn't depend on someone remembering to ask.",
  },
] as const satisfies readonly { n: string; screen: AppScreen; t: string; d: string }[];

const safety = ["Small by design", "Hosts approve requests", "18+ (21+ for drinks)", "Public places first"];
---

<section id="how" class="how wrap" aria-labelledby="how-title">
  <div class="how-head" data-reveal>
    <p class="kicker">How Covey works</p>
    <h2 id="how-title" class="t-title">three steps.<br />then it's a habit.</h2>
  </div>

  <div class="how-grid">
    <div class="how-stage-col" aria-hidden="true">
      <div class="how-sticky">
        <div class="how-panel meadow">
          <MeadowGround />
          <Phone screens={steps.map((s) => s.screen)} sizes="(min-width: 900px) 300px, 60vw" class="how-phone" />
        </div>
      </div>
    </div>

    <!-- Focusable so the swipeable row (phones) can be scrolled from the keyboard. -->
    <ol class="how-steps" tabindex="0" aria-label="How Covey works, in three steps">
      {
        steps.map((s, i) => (
          <li class="how-step" data-how-step={i + 1} data-screen={s.screen}>
            <div class="how-step-frame meadow" aria-hidden="true">
              <MeadowGround />
              <Phone screens={[s.screen]} sizes="70vw" class="frame-phone" />
            </div>
            <span class="how-n">{s.n}</span>
            <h3 class="how-t">{s.t}</h3>
            <p class="how-d">{s.d}</p>
          </li>
        ))
      }
    </ol>
    <p class="how-swipe" aria-hidden="true">
      <span>swipe</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </p>
  </div>

  <ul class="how-safety" data-reveal>
    {
      safety.map((s) => (
        <li>
          <Icon name="shield-check" size={16} />
          {s}
        </li>
      ))
    }
    <li><a href="/safety" class="arrow-link">How we keep it safe</a></li>
  </ul>
</section>

<style>
  .how {
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(3rem, 6vw, 5rem);
    /* Floating actors can drift past the stage edge; never let that scroll the page. */
    overflow-x: clip;
  }
  .how-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .how-stage-col {
    display: none;
  }
  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3.5rem;
  }
  .how-step-frame {
    width: min(100%, 26rem);
    margin-bottom: 1.5rem;
  }
  /* The lawn panel the phone stands on: Mobbin's screen-in-a-soft-panel,
     in Meadow. */
  .how-panel {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 6;
    border-radius: var(--rad-sheet);
    overflow: hidden;
    padding: 2rem;
  }
  .how-panel :global(.how-phone) {
    width: min(62%, 19rem);
  }
  .how-swipe {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .how-swipe svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .how-n {
    display: block;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--accent-ink);
    margin-bottom: 0.6rem;
  }
  .how-t {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--ink);
    margin-bottom: 0.9rem;
    max-width: 16ch;
  }
  .how-d {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 30rem;
  }
  .how-safety {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 1.5rem 0 0;
    border-top: 0.7px solid var(--edge);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .how-safety li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .how-safety :global(svg) {
    color: var(--accent-ink);
  }

  /* Phones and tablets: the three steps become a swipeable row of cards,
     each carrying its own frame of the stage, clipped to the card so the
     quails never drift past the screen edge. The next card peeks in to show
     there's more. */
  @media (max-width: 899px) {
    .how-steps {
      display: flex;
      /* Contains absolutely positioned descendants (.sr-only), which would
         otherwise escape the scroller and widen the page. */
      position: relative;
      gap: 0.85rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0.25rem var(--gutter) 1.25rem;
      scrollbar-width: none;
    }
    .how-steps::-webkit-scrollbar {
      display: none;
    }
    .how-steps:focus-visible {
      outline: 2px solid var(--accent-ink);
      outline-offset: 2px;
      border-radius: var(--rad-sheet);
    }
    .how-step {
      flex: 0 0 min(84%, 24rem);
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
      padding: 0.6rem 0.6rem 1.4rem;
      border-radius: var(--rad-sheet);
      background: var(--paper-elevated);
      border: 0.7px solid color-mix(in oklab, var(--edge) 80%, transparent);
      box-shadow: var(--shadow-paper);
    }
    /* The top of the screen, cropped by the card: the phone rises from
       the lawn and runs off the bottom edge. */
    .how-step-frame {
      width: 100%;
      height: 19rem;
      margin-bottom: 1.1rem;
      border-radius: calc(var(--rad-sheet) - 0.5rem);
      overflow: clip;
      display: flex;
      justify-content: center;
      padding-top: 1.5rem;
    }
    .how-step-frame :global(.frame-phone) {
      width: 72%;
      flex: none;
    }
    .how-n,
    .how-t,
    .how-d {
      padding-inline: 0.6rem;
    }
    .how-t {
      font-size: 1.45rem;
      margin-bottom: 0.6rem;
    }
    .how-d {
      font-size: 0.975rem;
      line-height: 1.55;
    }
    .how-swipe {
      display: flex;
    }
    .how-safety {
      margin-top: 2rem;
      gap: 0.6rem 1.25rem;
    }
  }

  @media (min-width: 900px) {
    .how {
      --how-top: 4rem;
    }
    .how-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: clamp(2.5rem, 6vw, 6rem);
    }
    .how-stage-col {
      display: block;
    }
    /* The sticky box is the viewport under the header, and the panel is
       centred in it, sized so it always fits on screen. */
    .how-sticky {
      position: sticky;
      top: var(--how-top);
      height: calc(100vh - var(--how-top));
      display: grid;
      align-items: center;
    }
    .how-panel {
      width: min(100%, 34rem, calc((100vh - var(--how-top) - 3rem) * 5 / 6));
    }
    .how-step-frame {
      display: none;
    }
    /* Each step's text is centred in a 72vh slot; pad the list so the
       first and last line up with the panel's centre. */
    .how-steps {
      gap: 0;
      padding-block: calc((100vh - var(--how-top) - 72vh) / 2) calc((100vh + var(--how-top) - 72vh) / 2);
    }
    /* The current step is marked with an accent rule, not by fading the
       others — dimmed text would fail contrast. */
    .how-step {
      position: relative;
      min-height: 72vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-left: 1.5rem;
    }
    .how-step::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 3px;
      height: 0;
      border-radius: 3px;
      background: var(--accent-ink);
      transform: translateY(-50%);
      transition: height 0.5s var(--ease-spring);
    }
    .how-step.is-current::before {
      height: 9rem;
    }
  }
</style>

<script>
  function initHow() {
    const stage = document.querySelector<HTMLElement>(".how-sticky .phone");
    const steps = Array.from(document.querySelectorAll<HTMLElement>("[data-how-step]"));
    if (!stage || !steps.length || stage.dataset.bound) return;
    stage.dataset.bound = "true";
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const step = e.target as HTMLElement;
          stage.dataset.screen = step.dataset.screen!;
          steps.forEach((s) => s.classList.toggle("is-current", s === e.target));
        }
      },
      // A thin band across the middle of the viewport picks the current step.
      { rootMargin: "-45% 0px -45% 0px" },
    );
    steps.forEach((s) => io.observe(s));
    steps[0].classList.add("is-current");
  }
  initHow();
  document.addEventListener("astro:page-load", initHow);
</script>
