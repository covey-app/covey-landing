---
/*
 * The mission, said once and shown: make friends doing things you'd do
 * anyway, without the crowd. One short headline, then the picture: six
 * plans, each a photograph of the thing itself with its activity
 * bubble (the same bubbles that ring Quinn in the hero), a few people
 * already going and one open seat. When the rows scroll in, the open seat
 * fills: that's you. No-JS and reduced motion show the filled seat.
 *
 * The photographs are mood (src/lib/photos.ts): the plan names are kinds of
 * plan, never a real listing, and nothing labels anyone in them.
 */
import Icon from "../Icon.astro";
import { CATEGORIES, type Category } from "../../lib/categories";
import { PHOTOS, photoSrc, type PhotoId } from "../../lib/photos";

// going: the people already in, by category colour (abstract avatars).
const plans: { c: Category; name: string; photo: PhotoId; going: Category[] }[] = [
  { c: "outdoors", name: "sunset hike", photo: "sunset-hike", going: ["food", "sports", "arts"] },
  { c: "sports", name: "pickup frisbee", photo: "pickup-frisbee", going: ["outdoors", "media", "nightlife", "food"] },
  { c: "food", name: "taco truck run", photo: "taco-truck", going: ["nightlife", "sports", "fashion"] },
  { c: "fashion", name: "record digging", photo: "record-store", going: ["media", "arts"] },
  { c: "media", name: "puzzle night", photo: "puzzle-night", going: ["culture", "food", "outdoors", "arts"] },
  { c: "arts", name: "homemade pizza", photo: "pizza-night", going: ["food", "sports", "culture", "media"] },
];
---

<section class="mission" aria-labelledby="mission-title">
  <div class="wrap">
    <p class="kicker" data-reveal>Our mission</p>
    <h2 id="mission-title" class="mission-title" data-reveal>
      <span class="m-lead">make friends doing things you'd do anyway.</span>
      <span class="m-rest">no crowds. no yelling over the music.</span>
    </h2>

    <ul class="plans" data-reveal>
      {
        plans.map((p, i) => (
          <li class="plan" style={`--i:${i}`}>
            <div class="plan-photo">
              <img
                {...photoSrc(p.photo)}
                sizes="(min-width: 1100px) 28rem, (min-width: 640px) 45vw, 50vw"
                alt={PHOTOS[p.photo].alt}
                style={PHOTOS[p.photo].focus && `object-position:${PHOTOS[p.photo].focus}`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="plan-bubble" style={`--c:var(--cat-${p.c})`} aria-hidden="true">
              <Icon name={CATEGORIES[p.c].icon} size={24} stroke={2.25} />
            </span>
            <span class="plan-name">{p.name}</span>
            <span class="plan-people">
              <span class="faces" aria-hidden="true">
                {p.going.map((g) => (
                  <span class="face" style={`--c:var(--cat-${g})`} />
                ))}
                <span class="face face--you">you</span>
              </span>
              <span class="sr-only">{p.going.length} going, plus you</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .mission {
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  .mission .kicker {
    margin-bottom: 1.5rem;
  }
  .mission-title {
    max-width: 22ch;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(2.1rem, 4.6vw, 4.4rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
    text-transform: lowercase;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .m-lead {
    display: block;
    color: var(--ink);
  }
  .m-rest {
    display: block;
    color: color-mix(in oklab, var(--ink) 46%, var(--page-bg));
  }

  /* ---- The plans ---- */
  .plans {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  /* Phones: compact cards, landscape crops and a smaller bubble, so six
     plans fit in about one screen. Tablets and up get the roomy card. */
  .plan {
    --pad: 0.75rem;
    --gap: 0.55rem;
    display: grid;
    align-content: start;
    gap: var(--gap);
    padding: var(--pad);
    border-radius: var(--rad-large);
    background: var(--paper-elevated);
    border: 0.7px solid var(--edge);
    box-shadow: var(--shadow-paper);
    overflow: hidden;
  }
  /* The photo runs to the card's edges; the bubble sits on its lower edge,
     half on the picture, half on the card, like a stop bead on a route. */
  .plan-photo {
    margin: calc(var(--pad) * -1) calc(var(--pad) * -1) 0;
    aspect-ratio: 4 / 3;
    background: var(--edge);
    overflow: hidden;
  }
  .plan-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plan-photo + .plan-bubble {
    margin-top: calc(var(--gap) * -1 - var(--bubble) / 2);
    position: relative;
  }
  /* The photos never fade in: the row rises only as a whole, and only
     the "you" seat waits for it. */
  :global(.js-motion) .plans[data-reveal]:not(.is-in) {
    opacity: 1;
    transform: none;
  }
  /* The activity bubble: category colour, white glyph, white rim, as in
     the hero ring. */
  .plan-bubble {
    --bubble: 2.5rem;
    display: grid;
    place-items: center;
    width: var(--bubble);
    height: var(--bubble);
    border-radius: 999px;
    background: var(--c);
    color: #fff;
    border: 2.5px solid #fff;
    box-shadow: 0 6px 14px -6px rgb(18 20 30 / 0.4);
  }
  .plan-bubble :global(svg) {
    width: 46%;
    height: 46%;
  }
  :global(.dark) .plan-bubble {
    color: #14140f;
    border-color: rgb(255 255 255 / 0.88);
  }
  .plan-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.6vw, 1.3rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }
  /* People going: overlapping avatars, then the open seat, which is you. */
  .faces {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.35rem;
  }
  .face {
    --d: 1.4rem;
    width: var(--d);
    height: var(--d);
    flex: none;
    border-radius: 999px;
    background: var(--c);
    border: 2px solid var(--paper-elevated);
  }
  .face + .face {
    margin-left: -0.45rem;
  }
  @media (min-width: 640px) {
    .plan {
      --pad: 1.25rem;
      --gap: 0.9rem;
      border-radius: var(--rad-sheet);
    }
    .plan-bubble {
      --bubble: 3.25rem;
      border-width: 3px;
    }
    .face {
      --d: 2rem;
    }
    .face + .face {
      margin-left: -0.55rem;
    }
  }
  .faces .face--you {
    display: grid;
    place-items: center;
    margin-left: 0.3rem;
    width: auto;
    min-width: var(--d);
    padding-inline: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    background: var(--ink);
    color: var(--page-bg);
    border-color: var(--ink);
  }

  @media (min-width: 1100px) {
    .plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .plan {
      --pad: 1.5rem;
      --gap: 1.1rem;
    }
    .plan-bubble {
      --bubble: 4rem;
    }
    .face {
      --d: 2.25rem;
    }
  }


  /* With motion: the open seat starts empty (dashed), then fills as the row
     comes in, one plan after another. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .plans:not(.is-in) .face--you {
      background: transparent;
      color: transparent;
      border: 2px dashed color-mix(in oklab, var(--ink) 40%, transparent);
    }
    .face--you {
      transition:
        background-color 0.35s var(--ease-out),
        color 0.35s var(--ease-out),
        border-color 0.35s var(--ease-out);
      transition-delay: calc(0.6s + var(--i, 0) * 0.18s);
    }
  }
</style>
