---
/*
 * The mission, said once and big: don't do it alone. A two-tone statement
 * (ink, then the muted follow-on) with the activity bubbles set inline in
 * the words, the same bubbles that ring Quinn in the hero.
 */
import Icon from "../Icon.astro";
import { CATEGORIES, type Category } from "../../lib/categories";

const inline: { c: Category; word: string }[] = [
  { c: "sports", word: "run" },
  { c: "food", word: "ramen crawl" },
  { c: "arts", word: "pottery class" },
  { c: "nightlife", word: "late set" },
];
---

<section class="mission" aria-labelledby="mission-title">
  <div class="wrap">
    <p class="kicker" data-reveal>Our mission</p>
    <h2 id="mission-title" class="mission-title" data-reveal>
      <span class="m-lead">find the people you've been missing.</span>
      <span class="m-rest">
        the ones who are down for the {inline.map((b, i) => (
          <>
            <span class="m-item"><span class="m-bubble" style={`--c:var(--cat-${b.c})`} aria-hidden="true"><Icon name={CATEGORIES[b.c].icon} size={24} stroke={2.25} /></span>{b.word}{i < inline.length - 1 ? "," : ""}</span>{" "}{i === inline.length - 2 ? "the " : ""}
          </>
        ))}you were going to do anyway.
      </span>
    </h2>
    <p class="mission-lede" data-reveal>
      Plenty of people want more friends and already have plans worth sharing.
      Covey puts them in the same small group, then makes it easy to see each
      other again.
    </p>
  </div>
</section>

<style>
  .mission {
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  .mission .kicker {
    margin-bottom: 1.5rem;
  }
  .mission-title {
    max-width: 22ch;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(2.1rem, 4.6vw, 4.4rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
    text-transform: lowercase;
    margin-bottom: 2rem;
  }
  .m-lead {
    display: block;
    color: var(--ink);
  }
  .m-rest {
    display: block;
    color: color-mix(in oklab, var(--ink) 46%, var(--page-bg));
  }
  /* A bubble stays with its word across a line break. */
  .m-item {
    white-space: nowrap;
  }
  /* A bubble sits in the line like a word: cap-height round, white rim,
     category colour, nudged onto the baseline. */
  .m-bubble {
    display: inline-grid;
    place-items: center;
    width: 0.92em;
    height: 0.92em;
    margin: 0 0.12em 0 0.04em;
    vertical-align: -0.12em;
    border-radius: 999px;
    background: var(--c);
    color: #fff;
    border: 0.06em solid #fff;
    box-shadow: 0 0.08em 0.2em rgb(18 20 30 / 0.18);
  }
  .m-bubble :global(svg) {
    width: 50%;
    height: 50%;
  }
  :global(.dark) .m-bubble {
    color: #14140f;
    border-color: rgb(255 255 255 / 0.88);
    box-shadow: 0 0.08em 0.2em rgb(0 0 0 / 0.5);
  }
  .mission-lede {
    max-width: 36rem;
    font-size: var(--fs-lede);
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
