---
/*
 * "This week in SF" — the doorway to /events: the next three listings, in a
 * warm newsprint room of their own. Its action is the events guide
 * (contextual, secondary), never a third waitlist button. Rebuilt with each
 * deploy; the build's "today" (todaySF) decides what's upcoming.
 */
import PickCard from "../guide/PickCard.astro";
import { publishedActivities, todaySF, upcomingEvents } from "../../lib/guide";

const picks = upcomingEvents(await publishedActivities(), todaySF(), 3);
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<section class="thisweek" aria-labelledby="thisweek-title">
  <div class="wrap">
    <div class="tw-head" data-reveal>
      <div>
        <p class="kicker">Events · San Francisco</p>
        <h2 id="thisweek-title" class="t-title">not sure what<br />to do this week?</h2>
      </div>
      <p class="tw-lede">
        We find things worth leaving the house for — after work, on the
        weekend, with people or on your own — and check every one with the
        organizer.
      </p>
    </div>

    {
      picks.length ? (
        <>
          <p class="tw-edition" data-reveal>Coming up</p>
          <div class="tw-picks">
            {picks.map((a, i) => (
              <div data-reveal style={`--d:${i}`}>
                <PickCard activity={a} why={a.data.summary} n={i + 1} />
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="tw-empty" data-reveal>The next batch of listings is being checked now. Check back soon.</p>
      )
    }

    <div class="tw-foot" data-reveal>
      <a href="/events" class="arrow-link">
        See all events
        <span set:html={arrow} />
      </a>
    </div>
  </div>
</section>

<style>
  .thisweek {
    --page-bg: #f5efe3;
    --paper-elevated: #fbf7ef;
    --edge: #d8cbb3;
    --ink: #241b12;
    --ink-muted: #625140;
    --ink-inverse: #f5efe3;
    --accent-ink: #a8361f;
    background: var(--page-bg);
    color: var(--ink);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    border-block: 0.7px solid var(--edge);
  }
  :global(.dark) .thisweek {
    --page-bg: #17120c;
    --paper-elevated: #241c13;
    --edge: #3a2f22;
    --ink: #f1e8d8;
    --ink-muted: #bfae96;
    --ink-inverse: #17120c;
    --accent-ink: #f08a6e;
  }
  .tw-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .tw-head .t-title {
    color: var(--ink);
    margin-top: 0.75rem;
  }
  .tw-lede {
    font-size: var(--fs-lede);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 32rem;
  }
  .tw-edition {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-muted);
    margin-bottom: 1rem;
  }
  .tw-picks {
    display: grid;
    gap: 1rem;
  }
  .tw-empty {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--ink);
    padding: 2rem 0;
    border-block: 2px dashed var(--edge);
  }
  .tw-foot {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-top: 3rem;
  }
  /* Phones: the three picks swipe sideways instead of stacking into three
     screens of cards. */
  @media (max-width: 767px) {
    .tw-head {
      margin-bottom: 2rem;
    }
    .tw-picks {
      display: flex;
      /* Contains absolutely positioned descendants (.sr-only), which would
         otherwise escape the scroller and widen the page. */
      position: relative;
      gap: 0.85rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0.25rem var(--gutter) 0.75rem;
      scrollbar-width: none;
    }
    .tw-picks::-webkit-scrollbar {
      display: none;
    }
    .tw-picks > div {
      flex: 0 0 min(84%, 22rem);
      scroll-snap-align: start;
    }
    .tw-foot {
      margin-top: 2.25rem;
    }
  }
  @media (min-width: 768px) {
    .tw-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .tw-picks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tw-foot {
      justify-content: end;
    }
  }
</style>
