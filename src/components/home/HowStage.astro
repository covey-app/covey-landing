---
/*
 * HowStage — one square scene that re-composes for each "how it works" step.
 * Actors are absolutely placed at the origin and moved with transforms in
 * container units (cqi), per step, so changing data-step glides everything
 * on the compositor. Used once, sticky, on wide screens (HomeHow drives
 * data-step) and three times, static, on phones (`step` prop).
 *
 *   1 · a plan; the flock is scattered, browsing — one of them is interested
 *   2 · four take seats in a row under the plan; Quinn joins; seats fill
 *   3 · they cluster into a covey around Quinn; the plan becomes recurring
 */
import Quinn from "../Quinn.astro";
import { birdSrc, type Category } from "../../lib/categories";
import { EXAMPLE_PLANS } from "../../lib/plans";

interface Props {
  step?: 1 | 2 | 3;
  live?: boolean;
}
const { step = 1, live = false } = Astro.props;
const plan = EXAMPLE_PLANS[0];

// [x, y, scale, opacity] per step, in cqi of the stage.
type Pose = [number, number, number, number];
const birds: { c: Category; poses: [Pose, Pose, Pose] }[] = [
  { c: "outdoors", poses: [[6, 4, 1.05, 1], [9, 60, 0.9, 1], [44, 50, 0.85, 1]] },
  { c: "food", poses: [[80, 8, 0.8, 0.5], [22, 60, 0.9, 1], [70, 46, 0.85, 1]] },
  { c: "arts", poses: [[82, 64, 0.8, 0.5], [35, 60, 0.9, 1], [40, 74, 0.85, 1]] },
  { c: "sports", poses: [[2, 70, 0.8, 0.5], [48, 60, 0.9, 1], [76, 70, 0.85, 1]] },
  { c: "media", poses: [[40, 84, 0.75, 0.4], [86, 86, 0.7, 0.35], [58, 84, 0.85, 1]] },
  { c: "nightlife", poses: [[66, 86, 0.75, 0.4], [-2, 88, 0.7, 0.35], [24, 62, 0.85, 1]] },
];
const quinnPoses: [Pose, Pose, Pose] = [[70, 58, 0.7, 0], [66, 42, 1, 1], [52, 36, 1.12, 1]];
const cardPoses: [Pose, Pose, Pose] = [[20, 24, 1, 1], [6, 6, 0.92, 1], [4, 2, 0.8, 1]];

const vars = (poses: [Pose, Pose, Pose]) =>
  poses.map(([x, y, s, o], i) => `--x${i + 1}:${x};--y${i + 1}:${y};--s${i + 1}:${s};--o${i + 1}:${o}`).join(";");
---

<div class:list={["how-stage", live && "is-live"]} data-how-stage data-step={step} aria-hidden="true">
  <div class="actor plan" style={vars(cardPoses)}>
    <div class="plan-card">
      <p class="plan-kicker">Example plan · {plan.hangout}</p>
      <p class="plan-title">{plan.title.toLowerCase()}</p>
      <p class="plan-meta">{plan.day} · {plan.timeRange.split(" – ")[0]} · {plan.stops.length} stops · {plan.area}</p>
      <div class="plan-seats">
        <span class="seat-dots">{Array.from({ length: plan.seats }, () => <i />)}</span>
        <span class="seat-text s1">3 of {plan.seats} seats taken</span>
        <span class="seat-text s2">5 of {plan.seats} seats taken</span>
        <span class="seat-text s3">Every other Saturday</span>
      </div>
    </div>
  </div>

  {
    birds.map((b, i) => {
      const art = birdSrc(b.c);
      return (
        <div class="actor bird" style={`${vars(b.poses)};--i:${i}`}>
          <img src={art.src} srcset={art.srcset} alt="" width="240" height="300" loading="lazy" decoding="async" />
        </div>
      );
    })
  }

  <div class="actor quinn-actor" style={vars(quinnPoses)}>
    <Quinn views={["front"]} sizes="120px" />
  </div>

  <p class="actor covey-tag" style="--x1:58;--y1:20;--s1:0.9;--o1:0;--x2:58;--y2:20;--s2:0.9;--o2:0;--x3:59;--y3:25;--s3:1;--o3:1">
    a covey · 7 members
  </p>
</div>

<style>
  .how-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    container-type: inline-size;
    /* No panel: the plan card, the flock, and Quinn float on the page. */
  }
  .actor {
    position: absolute;
    left: 0;
    top: 0;
    --x: var(--x1);
    --y: var(--y1);
    --s: var(--s1);
    --o: var(--o1);
    transform: translate(calc(var(--x) * 1cqi), calc(var(--y) * 1cqi)) scale(var(--s));
    transform-origin: 0 0;
    opacity: var(--o);
  }
  [data-step="2"] .actor {
    --x: var(--x2);
    --y: var(--y2);
    --s: var(--s2);
    --o: var(--o2);
  }
  [data-step="3"] .actor {
    --x: var(--x3);
    --y: var(--y3);
    --s: var(--s3);
    --o: var(--o3);
  }
  .is-live .actor {
    transition:
      transform 0.9s cubic-bezier(0.2, 0.9, 0.25, 1.04),
      opacity 0.5s ease;
    transition-delay: calc(var(--i, 0) * 45ms);
  }

  .plan {
    width: 62cqi;
    z-index: 2;
  }
  .plan-card {
    padding: 4.5cqi 5cqi;
    border-radius: 5cqi;
    background: var(--paper-elevated);
    box-shadow: var(--shadow-pinned);
    border: 0.7px solid color-mix(in oklab, var(--edge) 80%, transparent);
  }
  .plan-kicker {
    font-family: var(--font-mono);
    font-size: max(10px, 2.6cqi);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 1.6cqi;
  }
  .plan-title {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: max(14px, 5.4cqi);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin-bottom: 1.6cqi;
  }
  .plan-meta {
    font-size: max(11px, 2.9cqi);
    color: var(--ink-muted);
    margin-bottom: 3cqi;
  }
  .plan-seats {
    display: flex;
    align-items: center;
    gap: 2.5cqi;
    font-family: var(--font-mono);
    font-size: max(11px, 2.8cqi);
    color: var(--ink);
  }
  .seat-dots {
    display: inline-flex;
    gap: 1cqi;
  }
  .seat-dots i {
    width: 2.6cqi;
    height: 2.6cqi;
    border-radius: 99px;
    border: 1.3px solid color-mix(in oklab, var(--ink) 40%, transparent);
    transition: background-color 0.4s ease, border-color 0.4s ease;
  }
  .seat-dots i:nth-child(-n + 3),
  [data-step="2"] .seat-dots i:nth-child(-n + 5),
  [data-step="3"] .seat-dots i {
    background: var(--cat-outdoors);
    border-color: transparent;
  }
  .seat-text {
    display: none;
  }
  [data-step="1"] .seat-text.s1,
  [data-step="2"] .seat-text.s2,
  [data-step="3"] .seat-text.s3 {
    display: inline;
  }
  [data-step="3"] .seat-text.s3::before {
    content: "↻ ";
  }

  .bird {
    width: 17cqi;
    z-index: 3;
  }
  .bird img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.5cqi 2cqi rgb(18 20 30 / 0.14));
  }
  .quinn-actor {
    width: 19cqi;
    z-index: 4;
  }
  .covey-tag {
    z-index: 5;
    padding: 1.4cqi 3cqi;
    border-radius: 99px;
    background: var(--ink);
    color: var(--ink-inverse);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: max(11px, 2.8cqi);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .is-live .actor {
      transition: none;
    }
  }
</style>
