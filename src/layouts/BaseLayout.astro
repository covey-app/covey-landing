---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f4f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex" />}
    <ClientRouter />

    <title>{title} — {SITE.name}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${SITE.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${SITE.url}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${SITE.name}`} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@400;500;600;700&display=swap"
    />

    <!-- Theme bootstrap + toggle. Kept inline so it runs before paint and
         survives ClientRouter / transition:persist without module scripts. -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = "covey-theme";

        function preferDark() {
          try {
            var stored = localStorage.getItem(STORAGE_KEY);
            if (stored === "dark") return true;
            if (stored === "light") return false;
          } catch (e) {}
          return window.matchMedia("(prefers-color-scheme: dark)").matches;
        }

        function setThemeColor(dark) {
          var meta = document.querySelector('meta[name="theme-color"]:not([media])');
          if (!meta) {
            meta = document.createElement("meta");
            meta.setAttribute("name", "theme-color");
            document.head.appendChild(meta);
          }
          meta.setAttribute("content", dark ? "#0e0e10" : "#f4f4f4");
        }

        function syncButtons(dark) {
          document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
            btn.setAttribute("aria-pressed", String(dark));
            btn.setAttribute(
              "aria-label",
              dark ? "Switch to light mode" : "Switch to dark mode",
            );
          });
        }

        function apply(dark, doc) {
          doc = doc || document;
          doc.documentElement.classList.toggle("dark", dark);
          if (doc === document) {
            try {
              localStorage.setItem(STORAGE_KEY, dark ? "dark" : "light");
            } catch (e) {}
            setThemeColor(dark);
            syncButtons(dark);
          }
        }

        // Initial paint
        apply(preferDark(), document);

        if (!window.__coveyThemeInit) {
          window.__coveyThemeInit = true;

          document.addEventListener(
            "click",
            function (e) {
              var t = e.target;
              if (!t || !t.closest) return;
              if (!t.closest("[data-theme-toggle]")) return;
              e.preventDefault();
              apply(!document.documentElement.classList.contains("dark"), document);
            },
            true,
          );

          // Soft navigations swap a fresh <html> — re-apply before paint.
          document.addEventListener("astro:before-swap", function (event) {
            apply(preferDark(), event.newDocument);
          });

          document.addEventListener("astro:after-swap", function () {
            syncButtons(document.documentElement.classList.contains("dark"));
            setThemeColor(document.documentElement.classList.contains("dark"));
          });

          document.addEventListener("astro:page-load", function () {
            syncButtons(document.documentElement.classList.contains("dark"));
          });
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="min-h-screen flex flex-col">
      <Header transition:persist />
      <main id="main" class="flex-1" transition:animate="fade">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // Progressive enhancement only — every .reveal element is already
      // visible without this script (see the base .reveal rule in
      // global.css). This adds a soft fade/slide-up as sections enter the
      // viewport and firms the sticky header after a small scroll. Both are
      // re-initialised on every view transition via astro:page-load.
      function setupReveals() {
        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        const revealEls = document.querySelectorAll(
          ".reveal, .reveal-stagger",
        );
        if (prefersReducedMotion) {
          revealEls.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        document.documentElement.classList.add("js-ready");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -8% 0px" },
        );
        revealEls.forEach((el) => observer.observe(el));
      }

      // Sticky-header scrolled state — attach the scroll listener once; the
      // header element persists across view transitions.
      function setupHeaderScroll() {
        const w = window as unknown as { __coveyHeaderScroll?: boolean };
        if (w.__coveyHeaderScroll) return;
        w.__coveyHeaderScroll = true;
        const onScroll = () => {
          const header = document.querySelector("[data-header]");
          if (header) header.classList.toggle("is-scrolled", window.scrollY > 16);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // astro:page-load fires on the initial load and after every view
      // transition when ClientRouter is present.
      document.addEventListener("astro:page-load", () => {
        setupReveals();
        setupHeaderScroll();
      });
    </script>
  </body>
</html>
