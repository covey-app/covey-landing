---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f4f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex" />}
    <ClientRouter />

    <title>{title} — {SITE.name}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${SITE.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${SITE.url}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${SITE.name}`} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@400;500;600;700&display=swap"
    />

    <!-- Apply theme before paint; keep it across ClientRouter swaps. -->
    <script is:inline>
      (function () {
        function preferDark() {
          try {
            var stored = localStorage.getItem("covey-theme");
            if (stored === "dark") return true;
            if (stored === "light") return false;
          } catch (e) {}
          return window.matchMedia("(prefers-color-scheme: dark)").matches;
        }

        function apply(doc) {
          var root = doc.documentElement;
          if (preferDark()) root.classList.add("dark");
          else root.classList.remove("dark");
        }

        apply(document);

        // Without this, soft navigations swap in a fresh <html> without .dark
        // and the page flashes back to light mode.
        if (!window.__coveyThemeSwap) {
          window.__coveyThemeSwap = true;
          document.addEventListener("astro:before-swap", function (event) {
            apply(event.newDocument);
          });
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="min-h-screen flex flex-col">
      <Header transition:persist />
      <main id="main" class="flex-1" transition:animate="fade">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // Progressive enhancement only — every .reveal element is already
      // visible without this script (see the base .reveal rule in
      // global.css). This adds a soft fade/slide-up as sections enter the
      // viewport and firms the sticky header after a small scroll. Both are
      // re-initialised on every view transition via astro:page-load.
      function setupReveals() {
        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        const revealEls = document.querySelectorAll(
          ".reveal, .reveal-stagger",
        );
        if (prefersReducedMotion) {
          revealEls.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        document.documentElement.classList.add("js-ready");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -8% 0px" },
        );
        revealEls.forEach((el) => observer.observe(el));
      }

      // Sticky-header scrolled state — attach the scroll listener once; the
      // header element persists across view transitions.
      function setupHeaderScroll() {
        const w = window as unknown as { __coveyHeaderScroll?: boolean };
        if (w.__coveyHeaderScroll) return;
        w.__coveyHeaderScroll = true;
        const onScroll = () => {
          const header = document.querySelector("[data-header]");
          if (header) header.classList.toggle("is-scrolled", window.scrollY > 16);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // astro:page-load fires on the initial load and after every view
      // transition when ClientRouter is present.
      document.addEventListener("astro:page-load", () => {
        setupReveals();
        setupHeaderScroll();
      });
    </script>
  </body>
</html>
