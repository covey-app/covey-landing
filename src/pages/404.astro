---
import BaseLayout from "../layouts/BaseLayout.astro";
import CoveyMark from "../components/CoveyMark.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist." noIndex={true}>
  <div class="max-w-xl mx-auto px-6 py-32 text-center">
    <div class="flex justify-center mb-6">
      <CoveyMark variant="dots" dotSize={9} />
    </div>
    <div class="eyebrow mb-3">404</div>
    <h1 class="display t-h1 mb-6">That page wandered off.</h1>
    <p class="text-ink-muted leading-relaxed mb-8">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="flex justify-center gap-3 flex-wrap">
      <a href="/" class="btn btn-primary btn-lg">Back home</a>
      <a href="/about" class="btn btn-secondary btn-lg">About Covey</a>
    </div>
  </div>
</BaseLayout>
