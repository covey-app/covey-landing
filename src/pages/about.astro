---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistCTA from "../components/WaitlistCTA.astro";
import BirdDivider from "../components/BirdDivider.astro";
import CoveyMark from "../components/CoveyMark.astro";
import { SITE } from "../config";

const principles = [
  {
    n: "01",
    t: "Plans, not profiles.",
    d: "We don't sell you on someone's photos. We show you what the day actually looks like — where, when, with how many.",
  },
  {
    n: "02",
    t: "Small on purpose.",
    d: "Two to ten people. Anything bigger and the host stops being a host. We won't ship features that push capacity up for its own sake.",
  },
  {
    n: "03",
    t: "Real life over feeds.",
    d: "Covey should feel less like an app and more like a corkboard. Open it, find a plan, close it, go.",
  },
  {
    n: "04",
    t: "Hosts are the soul.",
    d: "The best plans come from people with strong taste and a generous instinct. We design every product decision around making their job easier.",
  },
];

const stats = [
  { k: "2025", v: "Founded" },
  { k: SITE.city.split(",")[0], v: "First city" },
  { k: "Invite-only", v: "iOS launch" },
];
---

<BaseLayout
  title="About"
  description="Covey is a plan-first social app built around real-world itineraries and small-group meetups, launching invite-only on iOS."
>
  <div class="max-w-4xl mx-auto px-6 py-[var(--section-y)]">
    <div class="eyebrow mb-3 flex items-center gap-2.5">
      <CoveyMark variant="dots" dotSize={6} />
      About
    </div>
    <h1 class="display t-h1 mb-8">A new shape for going out.</h1>

    <div class="space-y-6 leading-relaxed">
      <p class="text-xl md:text-2xl text-ink leading-snug max-w-3xl">
        Covey started with a simple frustration: most ways to meet people
        online have nothing to do with what you actually want to
        <em class="not-italic text-accent-ink font-medium">do</em>.
      </p>
      <p class="text-lg text-ink-muted">
        Group chats stall. Apps optimize for swipes, not Saturdays. The good
        plans live in someone's head and never leave it. We're building a
        plan-first social app instead — hosts publish small itineraries, a wine
        crawl, a bookstore loop, a sunrise hike, and a few seats stay open for
        whoever's curious.
      </p>
      <p class="text-lg text-ink-muted">
        Plans are intentionally small. Two to ten people, a date, a few stops,
        and a clear vibe. You're not joining a "community." You're showing up
        at the first stop.
      </p>
    </div>

    <div class="mt-16 grid sm:grid-cols-3 gap-5 reveal-stagger">
      {
        stats.map((s, i) => (
          <div class="card p-6 reveal-item" style={`--i:${i}`}>
            <div class="font-mono font-semibold text-2xl md:text-3xl text-ink tracking-tight text-balance">{s.k}</div>
            <div class="eyebrow mt-2">{s.v}</div>
          </div>
        ))
      }
    </div>

    <BirdDivider />

    <div class="card-pinned p-8 md:p-12 my-4 flex flex-col md:flex-row gap-8 items-center" style="border-radius: var(--radius-sheet)">
      <div class="shrink-0">
        <CoveyMark variant="dots" dotSize={16} />
      </div>
      <div>
        <div class="eyebrow mb-3">Where the name comes from</div>
        <p class="text-xl md:text-2xl text-ink leading-snug">
          A covey is a small flock of quail — never a crowd, always moving
          together. The same shape we're building the app around: a handful of
          people, one plan, one day.
        </p>
      </div>
    </div>

    <div class="mt-16">
      <div class="eyebrow mb-3">What we believe</div>
      <h2 class="display t-h2 mb-8">Four principles we build around.</h2>
      <ol class="space-y-8">
        {
          principles.map((p) => (
            <li class="grid md:grid-cols-12 gap-4 md:gap-8 border-t pt-8">
              <span class="md:col-span-2 font-mono font-semibold text-accent-ink text-3xl md:text-4xl tracking-tight">{p.n}</span>
              <div class="md:col-span-10">
                <h3 class="title-mono text-xl md:text-2xl text-ink mb-2">{p.t}</h3>
                <p class="text-ink-muted text-lg leading-relaxed max-w-2xl">{p.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <WaitlistCTA
    eyebrow="The city is the canvas."
    heading="Want to be part of it?"
    body="Join the waitlist and we'll email you the moment invites open in your city."
  />
</BaseLayout>
