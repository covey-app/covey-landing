---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Covey team — press, partnerships, support, or just to say hi."
>
  <div class="max-w-5xl mx-auto px-6 py-24 grid md:grid-cols-12 gap-16">
    <div class="md:col-span-5 space-y-6">
      <div class="eyebrow flex items-center gap-2">
          <img src="/images/bird-mark.png" alt="" class="bird-icon is-clay w-3.5 h-3.5" />
          Contact
        </div>
        <h1 class="display text-5xl md:text-6xl">Say hi.</h1>
      <p class="text-warm-gray text-lg leading-relaxed">
        For press, partnerships, host applications, or general questions —
        drop us a note. We read everything and try to reply within a few
        days.
      </p>

      <dl class="space-y-5 pt-6 border-t border-edge">
        <div class="flex justify-between items-baseline">
          <dt class="eyebrow">Hello</dt>
          <dd class="font-serif text-lg text-ink">{SITE.emails.hello}</dd>
        </div>
        <div class="flex justify-between items-baseline">
          <dt class="eyebrow">Press</dt>
          <dd class="font-serif text-lg text-ink">{SITE.emails.press}</dd>
        </div>
        <div class="flex justify-between items-baseline">
          <dt class="eyebrow">City</dt>
          <dd class="font-serif text-lg text-ink">{SITE.city}</dd>
        </div>
      </dl>
    </div>

    <div class="md:col-span-7">
      <form
        name="contact"
        method="POST"
        action={SITE.forms.contactEndpoint}
        class="vellum-panel p-8 space-y-6"
      >
        <input type="hidden" name="_next" value={`${SITE.url}/thanks`} />
        <input type="hidden" name="_subject" value="New Covey contact form message" />
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out if you're human: <input name="_gotcha" /></label>
        </p>

        <label class="block">
          <div class="eyebrow mb-2">Your name</div>
          <input
            required
            name="name"
            class="w-full bg-transparent border-b border-edge focus:border-ink outline-none py-2"
          />
        </label>

        <label class="block">
          <div class="eyebrow mb-2">Email</div>
          <input
            required
            type="email"
            name="email"
            class="w-full bg-transparent border-b border-edge focus:border-ink outline-none py-2"
          />
        </label>

        <label class="block">
          <div class="eyebrow mb-2">Subject</div>
          <select
            name="subject"
            class="w-full bg-transparent border-b border-edge focus:border-ink outline-none py-2"
          >
            <option>General question</option>
            <option>Press</option>
            <option>Partnership</option>
            <option>Host application</option>
            <option>Support</option>
          </select>
        </label>

        <label class="block">
          <div class="eyebrow mb-2">Message</div>
          <textarea
            required
            name="message"
            rows="6"
            class="w-full bg-paper paper-edge p-4 outline-none text-base resize-none"
          ></textarea>
        </label>

        <button class="btn btn-primary px-10 py-4 text-xs uppercase tracking-[0.2em]">
          <img
            src="/images/bird-mark.png"
            alt=""
            class="bird-icon w-4 h-4 object-contain"
            style="filter: brightness(0) invert(1);"
          />
          Send message
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
