---
/*
 * Contact by email only. The site used to carry a Netlify Forms contact form,
 * which does nothing on Vercel (where the site is hosted), so messages sent
 * through it were silently lost. Every channel here is a mailto link to an
 * inbox that exists. If a form comes back, it needs a Vercel-compatible
 * backend and a privacy policy update (§4.14) first.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import CoveyMark from "../components/CoveyMark.astro";
import { SITE } from "../config";

// One inbox for everything. The topics stay so people know what they can write about.
const email = SITE.emails.admin;
const topics = [
  { label: "Support", body: "Your account, the app, or the website." },
  { label: "Safety", body: "Reporting a person or content, and urgent safety concerns." },
  { label: "Privacy", body: "Data requests and privacy questions." },
  { label: "Press & partnerships", body: "Media inquiries, partnerships and collaborations." },
];---

<BaseLayout
  title="Contact"
  description="Get in touch with the Covey team by email — support, safety, privacy, press, or just to say hi."
>
  <div class="max-w-3xl mx-auto px-6 py-[var(--section-y)]">
    <div class="eyebrow flex items-center gap-2.5 mb-3">
      <CoveyMark variant="dots" dotSize={6} />
      Contact
    </div>
    <h1 class="display t-h1 mb-6">Say hi.</h1>
    <p class="text-ink-muted text-lg leading-relaxed mb-8">
      One inbox for everything. A person reads every email and we try to reply
      within a few days. We use what you send only to answer you; see our
      <a href="/privacy" class="text-accent-ink underline underline-offset-2 decoration-1">Privacy Policy</a>.
    </p>

    <a
      href={`mailto:${email}`}
      class="inline-block font-mono text-lg sm:text-xl text-ink hover:text-accent-ink transition-colors underline decoration-transparent hover:decoration-current underline-offset-4 break-all mb-12"
    >
      {email}
    </a>

    <dl class="space-y-6 border-t pt-8">
      {
        topics.map((row) => (
          <div class="grid sm:grid-cols-12 gap-1 sm:gap-6 items-baseline">
            <dt class="eyebrow sm:col-span-3">{row.label}</dt>
            <dd class="sm:col-span-9 text-ink-muted leading-relaxed">{row.body}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-12 text-ink-muted leading-relaxed">
      Covey is based in {SITE.city}. If someone is in immediate danger, call 911
      first.
    </p>
  </div>
</BaseLayout>
