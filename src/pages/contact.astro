---
import BaseLayout from "../layouts/BaseLayout.astro";
import CoveyMark from "../components/CoveyMark.astro";
import { SITE } from "../config";
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Covey team — press, partnerships, support, or just to say hi."
>
  <div class="max-w-5xl mx-auto px-6 py-24 grid md:grid-cols-12 gap-16">
    <div class="md:col-span-5 space-y-6">
      <div class="eyebrow flex items-center gap-2.5">
        <CoveyMark variant="dots" dotSize={6} />
        Contact
      </div>
      <h1 class="display text-5xl md:text-6xl">Say hi.</h1>
      <p class="text-ink-muted text-lg leading-relaxed">
        For press, partnerships, host applications, or general questions — drop
        us a note. We read everything and try to reply within a few days.
      </p>

      <dl class="space-y-5 pt-6 border-t">
        <div class="flex justify-between items-baseline gap-4">
          <dt class="eyebrow">Hello</dt>
          <dd class="font-mono text-ink">{SITE.emails.hello}</dd>
        </div>
        <div class="flex justify-between items-baseline gap-4">
          <dt class="eyebrow">Press</dt>
          <dd class="font-mono text-ink">{SITE.emails.press}</dd>
        </div>
        <div class="flex justify-between items-baseline gap-4">
          <dt class="eyebrow">City</dt>
          <dd class="font-mono text-ink">{SITE.city}</dd>
        </div>
      </dl>
    </div>

    <div class="md:col-span-7">
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        action="/thanks"
        class="card p-8 space-y-6"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <label class="block">
          <div class="eyebrow mb-2">Your name</div>
          <input
            required
            name="name"
            class="w-full bg-transparent border-b border-edge focus:border-accent-ink outline-none py-2 transition-colors"
          />
        </label>

        <label class="block">
          <div class="eyebrow mb-2">Email</div>
          <input
            required
            type="email"
            name="email"
            class="w-full bg-transparent border-b border-edge focus:border-accent-ink outline-none py-2 transition-colors"
          />
        </label>

        <label class="block">
          <div class="eyebrow mb-2">Subject</div>
          <select
            name="subject"
            class="w-full bg-transparent border-b border-edge focus:border-accent-ink outline-none py-2 transition-colors"
          >
            <option>General question</option>
            <option>Press</option>
            <option>Partnership</option>
            <option>Host application</option>
            <option>Support</option>
          </select>
        </label>

        <label class="block">
          <div class="eyebrow mb-2">Message</div>
          <textarea
            required
            name="message"
            rows="6"
            class="w-full card-sunken p-4 outline-none text-base resize-none focus:border-accent-ink transition-colors"
          ></textarea>
        </label>

        <button class="btn btn-primary px-10 py-4 text-xs">
          Send message
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
