---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistCTA from "../components/WaitlistCTA.astro";
import CoveyMark from "../components/CoveyMark.astro";
---

<BaseLayout
  title="Upcoming Events"
  description="Covey launch mixers, host meetups, and city rollout events — dates coming soon."
>
  <div class="max-w-4xl mx-auto px-6 py-24">
    <div class="eyebrow mb-3 flex items-center gap-2.5">
      <CoveyMark variant="dots" dotSize={6} />
      Upcoming events
    </div>
    <h1 class="display text-5xl md:text-6xl mb-6 text-balance">
      Meet the people building the first plans.
    </h1>
    <p class="text-ink-muted text-lg leading-relaxed max-w-2xl mb-14">
      Launch mixers, host meetups, and city-by-city rollout dates will land
      here first. We haven't locked anything in yet — join the waitlist and
      you'll hear about each event before it goes public.
    </p>

    <div class="card-sunken p-10 md:p-14 text-center">
      <div class="flex justify-center mb-6">
        <CoveyMark variant="dots" dotSize={10} />
      </div>
      <h2 class="title-mono text-2xl text-ink mb-3">Nothing on the calendar yet.</h2>
      <p class="text-ink-muted leading-relaxed max-w-md mx-auto mb-8">
        We'll post real dates here the moment they're confirmed — no
        placeholder events, no maybes.
      </p>
      <a href="/signup" class="btn btn-primary px-8 py-3.5 text-xs">
        Get notified
      </a>
    </div>
  </div>

  <WaitlistCTA
    eyebrow="Don't miss it"
    heading="Get notified about the next event."
    body="Waitlist members hear about launch mixers and city rollouts before anyone else."
  />
</BaseLayout>
