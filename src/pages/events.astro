---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistCTA from "../components/WaitlistCTA.astro";
import CoveyMark from "../components/CoveyMark.astro";
import EmptyState from "../components/EmptyState.astro";
---

<BaseLayout
  title="Upcoming Events"
  description="Covey launch mixers, host meetups, and city rollout events — dates coming soon."
>
  <div class="max-w-4xl mx-auto px-6 py-[var(--section-y)]">
    <div class="eyebrow mb-3 flex items-center gap-2.5">
      <CoveyMark variant="dots" dotSize={6} />
      Upcoming events
    </div>
    <h1 class="display t-h1 mb-6 text-balance">
      Meet the people building the first plans.
    </h1>
    <p class="text-ink-muted text-lg leading-relaxed max-w-2xl mb-12">
      Launch mixers, host meetups, and city-by-city rollout dates will land
      here first. We haven't locked anything in yet — join the waitlist and
      you'll hear about each event before it goes public.
    </p>

    <EmptyState
      title="Nothing on the calendar yet."
      body="We'll post real dates here the moment they're confirmed — no placeholder events, no maybes."
    >
      <a href="/signup" class="btn btn-primary">Join the flock</a>
      <a href="/about" class="btn btn-secondary">How Covey works</a>
    </EmptyState>
  </div>

  <WaitlistCTA
    eyebrow="Don't miss it"
    heading="Get notified about the next event."
    body="Waitlist members hear about launch mixers and city rollouts before anyone else."
  />
</BaseLayout>
