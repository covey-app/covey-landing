---
/*
 * Home — what Covey is, why it exists, and what makes it different, in four
 * movements: the hero (cast + headline), the problem (pinned beats), how it
 * works (sticky storytelling), and this week in SF (the doorway to the
 * newsletter and the activities guide).
 *
 * Prominent waitlist CTAs: two — the header and the hero. Every product claim
 * traces to shipped behavior in covey-ios (docs/landing-audit-2026-09-26.md
 * §2): headcount is host-set (default 6), and there's no "plan again" or
 * invite-past-attendees feature yet.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeProblem from "../components/home/HomeProblem.astro";
import HomeHow from "../components/home/HomeHow.astro";
import HomeThisWeek from "../components/home/HomeThisWeek.astro";
import { CITY_SHORT } from "../config";
---

<BaseLayout
  title="Make friends through small-group plans"
  description={`Covey turns strangers into friends through small-group plans and repeat hangouts in ${CITY_SHORT}. Join the waitlist.`}
  page="home"
>
  <HomeHero />
  <HomeProblem />
  <HomeHow />
  <HomeThisWeek />
</BaseLayout>
