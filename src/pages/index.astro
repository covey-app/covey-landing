---
/*
 * Home — the mission first, then the product, in six movements: the hero
 * (do it together, with the app in hand), the problem (pinned beats),
 * the mission (make friends doing things you'd do anyway, in photos), how it
 * works (the real iOS app, step by step), inside the app (a bento of its
 * screens), and the close (the fifty hours adding up, a wall of photos).
 *
 * Every screen is a capture of the iOS app in the Meadow theme with demo
 * data (docs/app-screens.md), and follows the site's light/dark toggle.
 *
 * Prominent waitlist CTAs: two — the header and the hero. Every product claim
 * traces to shipped behavior in covey-ios (docs/landing-audit-2026-09-26.md
 * §2): headcount is host-set (default 6), and there's no "plan again" or
 * invite-past-attendees feature yet.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeProblem from "../components/home/HomeProblem.astro";
import HomeMission from "../components/home/HomeMission.astro";
import HomeHow from "../components/home/HomeHow.astro";
import HomeApp from "../components/home/HomeApp.astro";
import HomeAfter from "../components/home/HomeAfter.astro";
---

<BaseLayout
  title="Do it together"
  description="Your friends aren't into everything you're into. Covey finds people who are, so you don't have to go alone, and next time you've got someone to go with. Join the waitlist."
  page="home"
>
  <HomeHero />
  <HomeProblem />
  <HomeMission />
  <HomeHow />
  <HomeApp />
  <HomeAfter />
</BaseLayout>
