---
import BaseLayout from "../layouts/BaseLayout.astro";
import JoinCTA from "../components/JoinCTA.astro";
import PlanInvite from "../components/PlanInvite.astro";
import PlanDemo from "../components/PlanDemo.astro";
import CoveyCard from "../components/CoveyCard.astro";
import CoveyJourney from "../components/CoveyJourney.astro";
import AppIcon from "../components/AppIcon.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../lib/icons";
import { EXAMPLE_PLANS, SAMPLE_PLANS } from "../lib/plans";
import { SITE, CITY_SHORT } from "../config";

/*
 * Every product claim on this page traces to shipped behavior in covey-ios —
 * see docs/landing-audit-2026-09-26.md §2 before adding one. In particular:
 * headcount is host-set (default 6, not "2–10"), and there is no "plan again"
 * or invite-past-attendees feature yet.
 */

const heroPlan = EXAMPLE_PLANS[0];

const contrasts = [
  {
    k: "A big event",
    d: "Too many people to really talk to. You leave with a first name, maybe.",
  },
  {
    k: "A chat-first app",
    d: "Weeks of messages, and still no plan.",
  },
  {
    k: "A Covey plan",
    d: "A handful of people, one thing you all want to do — and an easy way to do it again.",
    hi: true,
  },
];

const steps: { t: string; d: string; icon: IconName }[] = [
  {
    t: "Find a plan, or post one",
    d: "Browse public plans in your city, or build your own in a few taps. The plan co-pilot can draft stops for you to review.",
    icon: "sparkles",
  },
  {
    t: "Take a seat",
    d: "Open plans take one tap. Request-to-join plans go to the host first. Pick which stops you can make.",
    icon: "users",
  },
  {
    t: "Show up together",
    d: "Plan chat, day-of arrivals, and directions between stops keep everyone in step.",
    icon: "map-pin",
  },
];

const extras: { t: string; d: string; icon: IconName }[] = [
  { t: "Friends & group chats", d: "Add the people you click with and keep talking after the plan.", icon: "messages" },
  { t: "“When is everyone free?”", d: "Cross-check friends’ availability and start a plan in the gap.", icon: "calendar-plus" },
  { t: "Streaks", d: "“3-week streak. Host or join by Sunday to keep it.”", icon: "flame" },
];

const safety: { t: string; d: string; icon: IconName }[] = [
  {
    t: "Small by design",
    d: "Hosts set the headcount, six seats by default. Date plans are always two.",
    icon: "users",
  },
  {
    t: "Hosts approve requests",
    d: "On request-to-join plans, the host reviews who's coming before anyone gets a seat.",
    icon: "badge-check",
  },
  {
    t: "Adults, verified",
    d: "Covey is 18+, with identity verification in the app.",
    icon: "shield-check",
  },
  {
    t: "Public places first",
    d: "Every plan comes with a reminder to meet in public first, and you can report or block anyone.",
    icon: "map-pin",
  },
];

const faqs = [
  {
    q: "What is Covey?",
    a: "An app for meeting people through small, real-world plans. A host posts a short itinerary — a few stops, a time, a set number of seats — and people who like the same things join. When a group clicks, it can become a Covey and keep meeting up.",
  },
  {
    q: "How big are the plans?",
    a: "Small. The host sets the headcount, and it's six seats by default. Date plans are always two.",
  },
  {
    q: "What's a Covey?",
    a: "A standing group that plans things together — your climbing crew, book club, or Sunday pickup game. Coveys can be open, request-to-join, or invite-only, and can run a recurring plan weekly, every two weeks, or monthly.",
  },
  {
    q: "How much does it cost?",
    a: "Covey is free. Some plans have their own costs — a dinner, a class, a ticket — which you'd cover like any night out.",
  },
  {
    q: "Where is Covey available?",
    a: `Covey is starting in ${CITY_SHORT}, for adults 18 and over in the US. You can create an account on the web today; the iOS app is rolling out by invite.`,
  },
  {
    q: "Is it a dating app?",
    a: "No. Covey is about real plans first. Dating is an optional opt-in, and most plans are simply people doing something together.",
  },
];
---

<BaseLayout
  title="Make friends through small-group plans"
  description={`Covey helps you turn strangers into friends through small-group plans and repeat hangouts in ${CITY_SHORT}. Join a plan, meet people who like what you like, and keep meeting up.`}
>
  {/* ================= Hero ================= */}
  <section class="hero max-w-7xl mx-auto px-5 sm:px-6 pt-10 sm:pt-16 lg:pt-20 pb-16 lg:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-10 items-center">
      <div class="lg:col-span-7 hero-enter">
        <p class="eyebrow mb-5 sm:mb-6" style="--i:0">Small-group plans · {CITY_SHORT}</p>
        <h1 class="display t-hero hero-title text-balance mb-6" style="--i:1">
          turn strangers <br class="hero-br" />into <span class="accent-word">friends</span>, <br class="hero-br" />one plan at a time.
        </h1>
        <p class="lede mb-8" style="--i:2">
          Covey is for adults in {CITY_SHORT} who'd rather meet people by doing
          something. Join a small plan — a few stops, a few seats — and when it
          clicks, start a Covey and keep meeting up.
        </p>
        <div class="flex flex-col sm:flex-row gap-3" style="--i:3">
          <a href={SITE.joinUrl} class="btn btn-primary btn-lg w-full sm:w-auto">Join Covey</a>
          <a href="#how" class="btn btn-secondary btn-lg w-full sm:w-auto">
            See how a plan works
            <Icon name="arrow-down" size={16} />
          </a>
        </div>
        <p class="mt-5 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted" style="--i:4">
          Free · 18+ · On the web now, iOS by invite
        </p>
      </div>

      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <PlanInvite plan={heroPlan} />
      </div>
    </div>
  </section>

  {/* ================= What people plan ================= */}
  <section class="border-y" aria-labelledby="plans-band">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 py-5 sm:py-7 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
      <h2 id="plans-band" class="eyebrow shrink-0">What people plan</h2>
      <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
        {
          SAMPLE_PLANS.map((s) => (
            <li class="sample" style={`--c:var(--cat-${s.category})`}>
              <span class="orb" style="--orb:22px" aria-hidden="true">
                <Icon name={s.icon} />
              </span>
              {s.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ================= Why once isn't enough ================= */}
  <section id="why" class="max-w-7xl mx-auto px-5 sm:px-6 py-[var(--section-y)] reveal">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-4">Why once isn't enough</p>
        <h2 class="display t-h2 mb-6 text-balance">one good night isn't a friendship.</h2>
        <p class="lede mb-6 sm:mb-8">
          You meet someone great, swap numbers, and never see them again.
          Friendship takes repetition — and most ways of meeting people are
          built for the first hello, not the tenth.
        </p>

        <figure class="hours">
          <div class="hours-dots" aria-hidden="true">
            {Array.from({ length: 50 }, (_, i) => (
              <span class:list={["hour", i < 3 && "is-filled"]} style={`--i:${i}`} />
            ))}
          </div>
          <figcaption class="hours-caption">
            <strong>About 50 hours together</strong> turns an acquaintance into a
            casual friend.<sup><a href="#ref-hall" id="ref-hall-cite" aria-label="Source">1</a></sup>
            One evening out covers about three of them. The rest comes from
            showing up again.
          </figcaption>
        </figure>
      </div>

      <ul class="lg:col-span-6 grid gap-2 sm:gap-3 list-none m-0 p-0 reveal-stagger lg:pt-12">
        {
          contrasts.map((c, i) => (
            <li class:list={["contrast reveal-item", c.hi && "is-covey"]} style={`--i:${i}`}>
              <span class="contrast-k">
                {c.hi && <AppIcon size={22} />}
                {c.k}
              </span>
              <span class="contrast-d">{c.d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ================= How it works ================= */}
  <section id="how" class="max-w-7xl mx-auto px-5 sm:px-6 py-[var(--section-y)] reveal" aria-labelledby="how-title">
    <div class="grid lg:grid-cols-12 gap-6 lg:gap-16 items-end mb-10 lg:mb-12">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">How it works</p>
        <h2 id="how-title" class="display t-h2 text-balance">every plan is a small itinerary.</h2>
      </div>
      <p class="lede lg:col-span-5">
        A host picks a few stops, a time, and how many seats to open. You see
        exactly what you're saying yes to — and who else is going.
      </p>
    </div>

    <PlanDemo />

    <ol class="mt-8 lg:mt-12 grid md:grid-cols-3 gap-4 md:gap-8 list-none m-0 p-0 reveal-stagger">
      {
        steps.map((s, i) => (
          <li class="step reveal-item" style={`--i:${i}`}>
            <span class="step-n" aria-hidden="true">0{i + 1}</span>
            <div>
              <h3 class="step-t">{s.t}</h3>
              <p class="step-d">{s.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ================= The second hangout ================= */}
  <section id="coveys" class="coveys py-[var(--section-y)]" aria-labelledby="coveys-title">
    <div class="max-w-7xl mx-auto px-5 sm:px-6">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-16 lg:mb-20 reveal">
        <div class="lg:col-span-6">
          <p class="eyebrow mb-4">The second hangout</p>
          <h2 id="coveys-title" class="display t-h2 mb-6 text-balance">
            when it clicks, make it a <span class="accent-word">covey</span>.
          </h2>
          <p class="lede mb-8">
            A Covey is a standing group — your climbing crew, book club, or
            Sunday pickup game — that plans things together. Set a recurring
            plan and every member gets the invite, so meeting again doesn't
            depend on someone remembering to ask.
          </p>

          <div class="definition" id="why-covey">
            <AppIcon size={72} class="definition-quail" />
            <dl>
              <dt class="definition-word">
                covey <span class="definition-pron">/ kuh-vee /</span>
              </dt>
              <dd><span class="definition-n">1.</span> a small flock of birds.</dd>
              <dd><span class="definition-n">2.</span> a small group of people gathered together.</dd>
            </dl>
          </div>
        </div>
        <div class="lg:col-span-6 flex justify-center lg:justify-end">
          <div class="w-full max-w-md">
            <CoveyCard />
          </div>
        </div>
      </div>

      <CoveyJourney />

      <ul class="extras mt-16 grid-cols-3 gap-4 list-none m-0 p-0 reveal-stagger">
        {
          extras.map((x, i) => (
            <li class="extra reveal-item" style={`--i:${i}`}>
              <Icon name={x.icon} size={20} />
              <div>
                <h3 class="extra-t">{x.t}</h3>
                <p class="extra-d">{x.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ================= Safety ================= */}
  <section id="safety" class="max-w-7xl mx-auto px-5 sm:px-6 py-[var(--section-y)] reveal" aria-labelledby="safety-title">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow mb-4">Built for showing up</p>
        <h2 id="safety-title" class="display t-h2 mb-6 text-balance">small, verified, public first.</h2>
        <p class="lede mb-6">Meeting new people should feel easy, not risky.</p>
        <a href="/safety" class="text-link font-mono text-sm inline-flex items-center min-h-11">Read our safety guidelines</a>
      </div>
      <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-0 sm:gap-4 list-none m-0 p-0 reveal-stagger">
        {
          safety.map((s, i) => (
            <li class="card safety-item reveal-item" style={`--i:${i}`}>
              <span class="safety-icon" aria-hidden="true">
                <Icon name={s.icon} size={20} />
              </span>
              <h3 class="safety-t">{s.t}</h3>
              <p class="safety-d">{s.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ================= FAQ ================= */}
  <section class="max-w-3xl mx-auto px-5 sm:px-6 py-[var(--section-y)] reveal" aria-labelledby="faq-title">
    <p class="eyebrow mb-4 text-center">FAQ</p>
    <h2 id="faq-title" class="display t-h2 mb-10 text-center">good questions.</h2>
    <div class="space-y-3">
      {
        faqs.map((f) => (
          <details class="card faq-item p-0">
            <summary class="faq-q">
              {f.q}
              <span class="faq-plus" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <div>
                <p class="px-5 pb-5 text-ink-muted leading-relaxed">{f.a}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>

    <p id="ref-hall" class="mt-12 text-xs text-ink-muted leading-relaxed">
      <a href="#ref-hall-cite" class="text-link" aria-label="Back to the claim">1.</a>
      Hall, J. A. (2019). How many hours does it take to make a friend?
      <em>Journal of Social and Personal Relationships</em>.
      <a href="https://doi.org/10.1177/0265407518761225" class="text-link" rel="noreferrer">doi:10.1177/0265407518761225</a>
    </p>
  </section>

  <JoinCTA />
</BaseLayout>

<style>
  .hero-title {
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .hero-br {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero-br {
      display: inline;
    }
  }
  /* The hero card's rotated back sheet may poke past the gutter on phones;
     clip it without creating a scroll container. */
  .hero {
    overflow-x: clip;
  }

  /* What people plan — the app's signed-out sample plans, static. */
  .sample {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.7rem 0.25rem 0.25rem;
    border-radius: 999px;
    background-color: var(--paper-elevated);
    border: 0.7px solid color-mix(in oklab, var(--edge) 70%, transparent);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--ink);
  }
  @media (max-width: 639px) {
    .sample {
      font-size: 0.75rem;
    }
    /* Six examples make the point on a phone; nine wrap to five rows. */
    .sample:nth-child(n + 7) {
      display: none;
    }
  }

  /* Why — 50 hours as 50 dots; one evening fills three. */
  .hours {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background-color: var(--paper-elevated);
    border: 0.7px solid color-mix(in oklab, var(--edge) 55%, transparent);
    box-shadow: var(--shadow-paper);
    max-width: 32rem;
  }
  .hours-dots {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 6px;
    max-width: 16rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 639px) {
    .hours {
      padding: 1rem;
    }
    .hours-dots {
      max-width: 12.5rem;
      gap: 5px;
      margin-bottom: 0.75rem;
    }
  }
  .hour {
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1.2px solid color-mix(in oklab, var(--ink-subtle) 55%, transparent);
  }
  .hour.is-filled {
    border-color: transparent;
    background-color: var(--cat-food);
  }
  .hour.is-filled:nth-child(2) {
    background-color: var(--cat-outdoors);
  }
  .hour.is-filled:nth-child(3) {
    background-color: var(--cat-culture);
  }
  .hours-caption {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .hours-caption strong {
    color: var(--ink);
    font-weight: 600;
  }
  .hours-caption sup a {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    padding: 0 0.15em;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-ready) .reveal.is-visible .hour.is-filled {
      animation: hour-fill 0.4s var(--ease-pop) both;
      animation-delay: calc(0.35s + var(--i) * 0.12s);
    }
  }
  @keyframes hour-fill {
    from {
      transform: scale(0.3);
      opacity: 0;
    }
  }

  .contrast {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.15rem;
    border-radius: var(--radius-lg);
    border: 0.7px solid color-mix(in oklab, var(--edge) 90%, transparent);
  }
  .contrast-k {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.0625rem;
    color: var(--ink-muted);
  }
  .contrast-d {
    color: var(--ink-muted);
    line-height: 1.55;
  }
  @media (min-width: 640px) {
    .contrast {
      padding: 1.25rem 1.4rem;
    }
  }
  .contrast.is-covey {
    background-color: var(--paper-elevated);
    border-color: color-mix(in oklab, var(--ink) 80%, transparent);
    box-shadow: var(--shadow-pinned);
  }
  .contrast.is-covey .contrast-k,
  .contrast.is-covey .contrast-d {
    color: var(--ink);
  }

  /* How — steps */
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 0.7px solid var(--edge);
  }
  .step-n {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--accent-ink);
    padding-top: 0.2rem;
  }
  .step-t {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .step-d {
    color: var(--ink-muted);
    line-height: 1.6;
  }
  @media (max-width: 639px) {
    .step {
      padding-top: 0.9rem;
    }
    .step-d {
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }

  /* Coveys */
  .coveys {
    background-color: var(--paper);
    border-block: 0.7px solid var(--edge);
  }
  .definition {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem 1.25rem 1.25rem;
    border-radius: var(--radius-lg);
    background-color: var(--paper-elevated);
    border: 0.7px solid color-mix(in oklab, var(--edge) 55%, transparent);
    max-width: 32rem;
  }
  .definition-word {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }
  .definition-pron {
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-left: 0.4rem;
  }
  .definition dd {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }
  .definition-n {
    font-family: var(--font-mono);
    color: var(--accent-ink);
    margin-right: 0.35rem;
  }

  /* A plain divided list on phones; cards once there's room for three up. */
  .extra {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1rem 0;
    border-top: 0.7px solid var(--edge);
  }
  /* Secondary features: shown once there's room for them beside each other. */
  .extras {
    display: none;
  }
  @media (min-width: 768px) {
    .extras {
      display: grid;
    }
    .extra {
      padding: 1.25rem;
      border-radius: var(--radius-lg);
      background-color: var(--paper-elevated);
      border: 0.7px solid color-mix(in oklab, var(--edge) 55%, transparent);
    }
  }
  .extra > :global(svg) {
    flex: none;
    color: var(--accent-ink);
    margin-top: 0.15rem;
  }
  .extra-t {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }
  .extra-d {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    line-height: 1.5;
  }

  /* Safety — icon beside text on phones, stacked in the 2-up grid. */
  .safety-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: 1rem;
    padding: 1.25rem;
  }
  .safety-item > :not(.safety-icon) {
    grid-column: 2;
  }
  .safety-icon {
    grid-row: span 2;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background-color: var(--accent-soft);
    color: var(--accent-ink);
  }
  @media (max-width: 639px) {
    .safety-item {
      padding: 0.9rem 0;
      background: none;
      border: 0;
      border-top: 0.7px solid var(--edge);
      border-radius: 0;
      box-shadow: none;
    }
  }
  @media (min-width: 640px) {
    .safety-item {
      display: block;
      padding: 1.5rem;
    }
    .safety-icon {
      margin-bottom: 1rem;
    }
  }
  .safety-t {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.0625rem;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .safety-d {
    color: var(--ink-muted);
    line-height: 1.55;
  }

  /* FAQ */
  details > summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
