---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistCTA from "../components/WaitlistCTA.astro";
import WhyCovey from "../components/WhyCovey.astro";
import BirdDivider from "../components/BirdDivider.astro";
import DefinitionMoment from "../components/DefinitionMoment.astro";
import PlanCardMock from "../components/PlanCardMock.astro";
import CategoryChip from "../components/CategoryChip.astro";
import CoveyMark from "../components/CoveyMark.astro";
import { CATEGORIES } from "../lib/categories";
import { SITE } from "../config";

const heroCity = SITE.city.split(",")[0];

const heroPlan = {
  hangout: { label: "Event", tone: "slate" as const },
  join: { label: "Open", tone: "moss" as const },
  title: "Sunset wine crawl",
  stops: ["food", "food", "culture"],
  date: "Sat",
  time: "5:30p",
  city: heroCity,
  host: "Maya R",
  going: "4 going",
};

const secondaryPlan = {
  hangout: { label: "Casual", tone: "neutral" as const },
  join: { label: "Request", tone: "clay" as const },
  title: "Sunrise ridge hike",
  stops: ["outdoors", "outdoors"],
  date: "Sun",
  time: "6:00a",
  city: "Marin",
  host: "Devin K",
  going: "3 going",
};

const features = [
  {
    t: "Real-world plans",
    d: "Wine crawls, hikes, gallery days, dinners. Things that happen at a place, at a time — not another feed to scroll.",
    tag: "Show up",
  },
  {
    t: "Small groups",
    d: "Hosts cap each plan between two and ten people. The size keeps every plan human.",
    tag: "2–10 people",
  },
  {
    t: "Host-led",
    d: "One person owns the day. They pick the stops, set the tone, and choose who joins.",
    tag: "One host",
  },
  {
    t: "Local first",
    d: `Launching invite-only in ${heroCity}. Every plan happens somewhere you can actually walk to.`,
    tag: heroCity,
  },
];

const steps = [
  {
    n: "01",
    t: "Sketch or browse",
    d: "Hosts publish a few stops, a date, and a vibe. Everyone else scrolls for a plan that fits their week.",
  },
  {
    n: "02",
    t: "Claim a spot",
    d: "Plans are open-join, request-to-join, or invite-only. You always know how many seats are left.",
  },
  {
    n: "03",
    t: "Meet at the first stop",
    d: "Once you're in, the details are yours. Show up, introduce yourself, and follow the itinerary.",
  },
];

const faqs = [
  {
    q: "What is Covey, exactly?",
    a: "A plan-first social app. Instead of profiles and feeds, hosts publish small real-world itineraries — a few stops, a date, a vibe — and open a handful of seats to whoever's curious.",
  },
  {
    q: "How big are the groups?",
    a: "Two to ten people per plan. Small on purpose: big enough to meet someone new, small enough that everyone actually talks.",
  },
  {
    q: "How much does it cost?",
    a: "Covey is free to use. Some plans may have their own costs (a dinner reservation, a class fee), but the app itself doesn't charge you to join.",
  },
  {
    q: "When can I get in?",
    a: `We're launching invite-only on iOS, starting in ${heroCity}. Join the waitlist and we'll reach out the moment a spot opens in your city.`,
  },
];
---

<BaseLayout
  title="Anything, anytime, together"
  description="Covey is a plan-first social app launching invite-only on iOS. Hosts publish small real-world itineraries and a few seats stay open for whoever's curious."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 md:pt-20 pb-14 sm:pb-16 lg:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-10 sm:gap-y-12 lg:gap-8 items-center">
      <div class="lg:col-span-6 hero-enter">
        <div class="eyebrow mb-5 sm:mb-6 flex items-center gap-2.5" style="--i:0">
          <CoveyMark variant="dots" dotSize={6} />
          <span class="leading-snug">{SITE.launchRegion}</span>
        </div>
        <h1 class="display t-hero text-balance mb-5 sm:mb-7" style="--i:1">
          Anything, anytime, <span class="text-accent-ink">together</span>.
        </h1>
        <p class="max-w-md text-[1.0625rem] sm:text-lg text-ink-muted leading-relaxed mb-7 sm:mb-9" style="--i:2">
          Covey is a plan-first social app. Hosts publish small real-world
          itineraries and a few seats stay open for whoever's curious.
        </p>
        <div class="flex flex-col sm:flex-row flex-wrap gap-3" style="--i:3">
          <a href="/signup" class="btn btn-primary btn-lg w-full sm:w-auto">Join the flock</a>
          {
            SITE.appIsLive ? (
              <a href={SITE.browseUrl} class="btn btn-secondary btn-lg w-full sm:w-auto">
                Browse plans
              </a>
            ) : (
              <a href="/about" class="btn btn-secondary btn-lg w-full sm:w-auto">How it works</a>
            )
          }
        </div>
        <ul class="mt-7 sm:mt-8 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted flex flex-col sm:flex-row gap-2 sm:gap-0 sm:flex-wrap sm:items-center list-none p-0 m-0" style="--i:4">
          <li class="sm:after:content-['·'] sm:after:mx-4 sm:after:opacity-40">Free to use</li>
          <li class="sm:after:content-['·'] sm:after:mx-4 sm:after:opacity-40">2–10 person plans</li>
          <li>iOS first, invite-only</li>
        </ul>
      </div>

      <div class="lg:col-span-6">
        <div class="hero-visual mx-auto max-w-md lg:max-w-none animate-paper-rise">
          <div class="hero-def card-pinned p-5 sm:p-7 md:p-10" style="border-radius: var(--radius-sheet)">
            <DefinitionMoment />
          </div>
          <div class="hero-mock mt-5 sm:mt-6 mx-auto w-full max-w-[17rem] lg:mt-0 lg:mx-0 lg:absolute lg:-bottom-6 lg:-right-3 lg:w-60 lg:rotate-3">
            <PlanCardMock {...heroPlan} class="lg:shadow-floating" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-y">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-6">
      <div class="flex md:flex-wrap md:items-center gap-3 items-center overflow-x-auto no-scrollbar edge-fade md:overflow-visible md:[-webkit-mask-image:none] md:[mask-image:none]">
        <span class="eyebrow shrink-0 mr-1">Plans across</span>
        {
          CATEGORIES.map((c) => (
            <CategoryChip categoryKey={c.key} label={c.label} class="shrink-0" />
          ))
        }
      </div>
    </div>
  </div>

  <WhyCovey />

  <BirdDivider />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-[var(--section-y)] grid md:grid-cols-12 gap-10 lg:gap-16 items-start reveal">
    <div class="md:col-span-5 md:sticky md:top-24">
      <div class="eyebrow mb-3">What it is</div>
      <h2 class="display t-h2 mb-5 sm:mb-6">Not a feed. A corkboard.</h2>
      <p class="text-ink-muted leading-relaxed text-[1.0625rem] sm:text-lg">
        Covey isn't trying to be another social network. It's a place where
        one person sketches an itinerary — a few stops, a date, a mood — and
        the right two or three people show up.
      </p>
      <a
        href="/about"
        class="inline-flex min-h-11 md:min-h-0 items-center mt-6 sm:mt-8 font-mono text-xs uppercase tracking-[0.16em] border-b border-ink pb-1 hover:text-accent-ink hover:border-accent-ink transition-colors"
      >
        More about Covey →
      </a>
    </div>
    <div class="md:col-span-7 grid sm:grid-cols-2 gap-4 sm:gap-5 reveal-stagger">
      {
        features.map((f, i) => (
          <div class="card p-5 sm:p-6 reveal-item" style={`--i:${i}`}>
            <span class="badge badge-accent mb-4">{f.tag}</span>
            <h3 class="title-mono text-xl text-ink mb-2 mt-3">{f.t}</h3>
            <p class="text-[0.9875rem] sm:text-[0.95rem] text-ink-muted leading-relaxed">{f.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-[var(--section-y-tight)] reveal">
    <div class="grid md:grid-cols-2 gap-6 md:gap-16 items-end mb-10 sm:mb-12">
      <div>
        <div class="eyebrow mb-4">How it works</div>
        <h2 class="display t-h2">Three steps, no group chat.</h2>
      </div>
      <p class="text-ink-muted leading-relaxed text-[1.0625rem] sm:text-lg">
        Whether you're hosting your first plan or joining one, the flow is the
        same shape: find or sketch the day, lock in your seat, and show up at
        the first stop.
      </p>
    </div>

    <ol class="grid md:grid-cols-3 gap-4 sm:gap-5 reveal-stagger">
      {
        steps.map((s, i) => (
          <li class="card p-6 sm:p-7 reveal-item" style={`--i:${i}`}>
            <div class="font-mono font-semibold text-4xl text-accent-ink mb-4 tracking-tight">
              {s.n}
            </div>
            <h3 class="title-mono text-xl text-ink mb-2">{s.t}</h3>
            <p class="text-ink-muted leading-relaxed text-[0.9875rem] sm:text-base">{s.d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-[var(--section-y-tight)] reveal">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-14 items-center">
      <div>
        <div class="eyebrow mb-4">A real plan</div>
        <h2 class="display t-h2 mb-5 sm:mb-6">
          Every plan is an itinerary.
        </h2>
        <p class="text-ink-muted leading-relaxed text-[1.0625rem] sm:text-lg mb-4">
          Not a vague "let's hang out." A host lays out the stops, the time,
          and the vibe — so you know exactly what you're saying yes to.
        </p>
        <p class="text-ink-muted leading-relaxed text-[1.0625rem] sm:text-lg">
          Category-tinted stops, a clear seat count, and one person owning the
          day. That's the whole card.
        </p>
      </div>
      <div class="flex justify-center items-center gap-5 flex-wrap">
        <PlanCardMock {...heroPlan} rotate={-2} />
        <PlanCardMock {...secondaryPlan} rotate={2} class="hidden sm:flex" />
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-[var(--section-y-tight)] grid md:grid-cols-2 gap-4 sm:gap-6 reveal">
    <a href="/events" class="card card-link p-7 sm:p-9 md:p-10">
      <div class="eyebrow mb-3">Get involved</div>
      <h3 class="display t-h3 mb-4">See what's coming up.</h3>
      <p class="text-ink-muted leading-relaxed mb-6">
        Launch mixers, host meetups, and city-by-city rollout dates will land
        here first as we open each region.
      </p>
      <span class="font-mono text-xs uppercase tracking-[0.16em] text-accent-ink">
        Upcoming events →
      </span>
    </a>
    <a href="/testimonials" class="card card-link p-7 sm:p-9 md:p-10">
      <div class="eyebrow mb-3">Early stories</div>
      <h3 class="display t-h3 mb-4">Real reactions, soon.</h3>
      <p class="text-ink-muted leading-relaxed mb-6">
        We'd rather show real quotes than invent them. Once early hosts and
        joiners have run their first plans, their stories go here.
      </p>
      <span class="font-mono text-xs uppercase tracking-[0.16em] text-accent-ink">
        What's coming →
      </span>
    </a>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-[var(--section-y-tight)] reveal">
    <div class="eyebrow mb-3 text-center">FAQ</div>
    <h2 class="display t-h2 mb-8 sm:mb-10 text-center">Good questions.</h2>
    <div class="space-y-3">
      {
        faqs.map((f) => (
          <details class="card faq-item p-0 group">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-4 sm:p-5 title-mono text-base sm:text-lg text-ink">
              {f.q}
              <span class="faq-plus font-mono text-ink-muted text-2xl leading-none shrink-0" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <div>
                <p class="px-4 sm:px-5 pb-5 text-ink-muted leading-relaxed text-[0.9875rem] sm:text-base">{f.a}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <WaitlistCTA />
</BaseLayout>

<style>
  /*
   * Hero: the plan card overlaps the definition card on the same row (lg+).
   * Whichever card you hover/focus is brought to the front, so the overlap
   * never permanently hides content on pointer devices.
   */
  .hero-visual {
    position: relative;
  }
  @media (min-width: 1024px) {
    .hero-def {
      position: relative;
      z-index: 1;
      transition: box-shadow 0.25s ease;
    }
    .hero-mock {
      z-index: 2;
      transition:
        transform var(--motion-card),
        box-shadow 0.25s ease;
    }
    .hero-def:hover,
    .hero-def:focus-within {
      z-index: 3;
    }
    .hero-mock:hover,
    .hero-mock:focus-within {
      z-index: 3;
    }
  }
  @media (min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero-mock:hover {
      transform: rotate(3deg) translateY(-3px);
    }
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary {
    border-radius: var(--radius-lg);
    transition: background-color 0.2s ease;
  }
  .faq-item summary:hover,
  .faq-item summary:focus-visible {
    background-color: color-mix(in oklab, var(--ink) 4%, transparent);
  }
  details[open] .faq-plus {
    transform: rotate(45deg);
  }
  .faq-plus {
    transition: transform var(--motion-standard);
    display: inline-block;
  }
</style>
