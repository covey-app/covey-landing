---
/*
 * /privacy renders the authoritative instrument at docs/legal/privacy-policy.md.
 * See the note in terms.astro — this page carries no legal text of its own.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalDocument from "../components/LegalDocument.astro";
import { Content, getHeadings } from "../../docs/legal/privacy-policy.md";
---

<BaseLayout
  title="Privacy Policy"
  description="The Covey Privacy Policy — what personal information Covey collects, how it is used, disclosed, retained, and secured, and the rights you may exercise."
>
  <LegalDocument eyebrow="Privacy" headings={getHeadings()}>
    <Content />
  </LegalDocument>
</BaseLayout>
