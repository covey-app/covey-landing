---
import BaseLayout from "../layouts/BaseLayout.astro";
import CoveyMark from "../components/CoveyMark.astro";
import FormField from "../components/FormField.astro";
import FormEnhance from "../components/FormEnhance.astro";
import { SITE } from "../config";
---

<BaseLayout
  title="Join the waitlist"
  description="Join the Covey waitlist. We're launching invite-only on iOS, starting in San Francisco."
>
  <div class="max-w-2xl mx-auto px-6 py-[var(--section-y)] text-center">
    <div class="flex justify-center mb-6">
      <CoveyMark variant="dots" dotSize={11} animate />
    </div>
    <div class="eyebrow mb-3">{SITE.launchRegion}</div>
    <h1 class="display t-h1 mb-6">Be first in the flock.</h1>
    <p class="text-ink-muted text-lg leading-relaxed mb-12 max-w-xl mx-auto">
      Covey is rolling out invite-only on iOS, starting in {SITE.city}. Drop
      your email below and we'll reach out the moment a spot opens up — no
      spam, just the invite when it's ready.
    </p>

    <form
      name="waitlist"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thanks"
      data-astro-reload
      data-enhance
      novalidate
      class="card p-7 sm:p-8 text-left"
    >
      <input type="hidden" name="form-name" value="waitlist" />
      <p class="hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>

      <FormField
        type="email"
        name="email"
        label="Email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder="you@example.com"
        error="Enter a valid email so we can send your invite."
      />
      <FormField name="name" label="First name" autocomplete="given-name" />
      <FormField name="city" label="City" placeholder="Where should we launch next?" />

      <label class="flex items-start gap-3 text-sm text-ink-muted mt-5">
        <input required type="checkbox" name="over18" class="mt-1 h-4 w-4 accent-[color:var(--accent-ink)]" />
        <span>I confirm I'm 18 or older.</span>
      </label>

      <button type="submit" class="btn btn-primary btn-lg w-full justify-center mt-7">
        Join the flock
      </button>
    </form>

    {
      SITE.appIsLive && (
        <p class="font-mono text-xs text-ink-muted mt-8 uppercase tracking-[0.16em]">
          Already have an invite?{" "}
          <a
            href={SITE.signInUrl}
            class="border-b border-ink-muted hover:text-ink hover:border-ink transition-colors"
          >
            Sign in →
          </a>
        </p>
      )
    }
  </div>
  <FormEnhance />
</BaseLayout>
