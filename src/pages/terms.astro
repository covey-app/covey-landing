---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

/*
 * Terms of Service — rewritten 2026-09-01 against the actual product. See
 * docs/legal-audit-2026-09-01.md for the evidence trail and open items.
 *
 * Editing rules:
 *
 * 1. Covey launches free. `launch_paid_plans_enabled` defaults false and the
 *    database refuses to create a paid plan while it is closed. Nothing in this
 *    document may imply Covey charges, processes payments, or sells anything.
 *    If that gate is ever opened, payment terms must land here in the same
 *    change, and the version below must be bumped.
 * 2. The risk-allocation block (§§16-19) is what does the work if something
 *    goes wrong offline. §9 (no screening) and §10 (in-person safety) are the
 *    load-bearing ones for a product that puts strangers in the same room.
 *    Keep them conspicuous — uppercase and boxed is deliberate, not decorative.
 * 3. `SITE.legal.version` is stamped into `policy_acceptances` by the iOS app.
 *    A substantive edit here means bumping that constant, the Swift literal in
 *    LegalPolicy.swift, and `current_policy_version()` together.
 */
const lastUpdated = SITE.legal.effective;
const entity = SITE.legal.entity;

const toc: { id: string; label: string }[] = [
  { id: "agreement", label: "1. Agreement to these terms" },
  { id: "eligibility", label: "2. Who may use Covey" },
  { id: "account", label: "3. Your account" },
  { id: "verification", label: "4. Identity verification" },
  { id: "service", label: "5. The service, and that it is free" },
  { id: "your-content", label: "6. Your content" },
  { id: "ai", label: "7. AI-generated content" },
  { id: "acceptable-use", label: "8. Acceptable use" },
  { id: "no-screening", label: "9. We do not screen members" },
  { id: "meeting", label: "10. Meeting people, dating, and real-world risk" },
  { id: "reporting", label: "11. Reporting, blocking, and moderation" },
  { id: "third-parties", label: "12. Third-party services" },
  { id: "copyright", label: "13. Copyright and DMCA" },
  { id: "our-ip", label: "14. Covey's intellectual property" },
  { id: "termination", label: "15. Suspension, termination, and deletion" },
  { id: "disclaimers", label: "16. Disclaimers" },
  { id: "liability", label: "17. Limitation of liability" },
  { id: "indemnification", label: "18. Indemnification" },
  { id: "disputes", label: "19. Dispute resolution and arbitration" },
  { id: "governing-law", label: "20. Governing law and venue" },
  { id: "apple", label: "21. Apple App Store terms" },
  { id: "changes", label: "22. Changes to these terms" },
  { id: "general", label: "23. General terms" },
  { id: "contact", label: "24. Contact" },
];

const prohibited: string[] = [
  "Harass, bully, threaten, stalk, defame, or intimidate anyone.",
  "Impersonate another person, misrepresent your identity, age, or affiliation, or submit an identity document that is not your own.",
  "Post or send content that is unlawful, sexually explicit, hateful, or that promotes violence, self-harm, or discrimination.",
  "Share another person's private information — home address, phone number, workplace, images, or messages — without their consent.",
  "Use Covey to organise, promote, or carry out illegal or dangerous activity, including the sale of drugs or weapons, commercial sexual services, human trafficking, doxxing, or stalking.",
  "Solicit money, gifts, investments, or cryptocurrency from other members, or run any romance, advance-fee, or investment scam.",
  "Contact, or attempt to contact, anyone who has blocked you, or evade a block, suspension, or ban by creating another account.",
  "Take, share, or publish screenshots of another member's private messages, photos, or dating profile outside Covey without their consent.",
  "Spam, send unsolicited commercial messages, or use plans and groups to advertise unrelated products or services.",
  "Scrape, crawl, harvest, or bulk-collect members' content, profiles, photos, or contact details, by hand or by machine.",
  "Access Covey through an unauthorised client or automated system, or attempt to bypass rate limits, invite gating, verification, or access controls.",
  "Probe, scan, or test the security of the service other than through the process in our security policy, or interfere with its operation.",
  "Reverse engineer, decompile, or disassemble any part of Covey, except where that restriction is unenforceable under applicable law.",
  "Use another member's content to train a machine-learning model, or to build a competing product.",
];
---

<BaseLayout
  title="Terms of Service"
  description="The terms that govern your use of Covey — eligibility, verification, content, safety, disclaimers, and dispute resolution."
>
  <div class="max-w-3xl mx-auto px-6 py-[var(--section-y)]">
    <div class="eyebrow mb-3">Terms</div>
    <h1 class="display t-h1 mb-4">Terms of service</h1>
    <p class="font-mono text-ink-muted text-xs uppercase tracking-[0.16em] mb-12">
      Effective {lastUpdated} · Version {SITE.legal.version}
    </p>

    <div class="card p-6 mb-10 legal-prose">
      <p class="text-ink-muted leading-relaxed">
        <strong class="text-ink">Please read this before you sign up.</strong>
        These terms are a binding contract between you and {entity} ("Covey",
        "we", "us"). Three parts change your legal position and are worth
        reading in full:
      </p>
      <ul class="text-ink-muted leading-relaxed mt-4 space-y-2 list-disc pl-6">
        <li>
          <a href="#no-screening">Section 9</a> and
          <a href="#meeting">Section 10</a> — we do not vet who other members
          really are beyond a document check, you meet them at your own risk,
          and you release us from claims arising out of those meetings.
        </li>
        <li>
          <a href="#liability">Section 17</a> — our liability to you is capped
          at one hundred dollars.
        </li>
        <li>
          <a href="#disputes">Section 19</a> — most disputes go to individual
          binding arbitration. You give up the right to a jury trial and to join
          a class action. You have 30 days to opt out of that.
        </li>
      </ul>
      <p class="text-ink-muted leading-relaxed mt-4">
        By tapping to accept, creating an account, or using Covey, you agree to
        these terms. If you do not agree, do not use Covey.
      </p>
    </div>

    <nav aria-label="Table of contents" class="card-sunken p-6 mb-12">
      <h2 class="eyebrow mb-4">On this page</h2>
      <ol class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm text-ink-muted list-none">
        {
          toc.map((item) => (
            <li>
              <a href={`#${item.id}`} class="hover:text-ink transition-colors">
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="legal-prose space-y-10 text-ink-muted leading-relaxed text-lg">
      <section id="agreement" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">1. Agreement to these terms</h2>
        <p>
          These Terms of Service (the "Terms") govern your access to and use of
          the Covey app, the {SITE.domain} website, and everything we provide
          through them (together, the "Service"). They incorporate our
          <a href="/privacy">Privacy Policy</a>.
        </p>
        <p class="mt-4">
          Each published version of these Terms carries a version stamp — this
          one is <strong class="text-ink">{SITE.legal.version}</strong>. When you
          accept, we record which version you accepted and when. That record is
          how we and you can both tell later what you agreed to.
        </p>
      </section>

      <section id="eligibility" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">2. Who may use Covey</h2>
        <p>To use the Service, you must:</p>
        <ul class="mt-4 space-y-2 list-disc pl-6">
          <li><strong class="text-ink">be at least 18 years old</strong> — Covey is an adults-only service and there are no exceptions;</li>
          <li>be able to form a binding contract with us;</li>
          <li>give us a truthful date of birth and a genuine identity document that is yours;</li>
          <li>not be required to register as a sex offender in any jurisdiction;</li>
          <li>not have been convicted of a felony, or of any crime involving violence or sexual misconduct;</li>
          <li>not be barred from using the Service under United States law, not be located in a country subject to a U.S. Government embargo, and not appear on any U.S. Government restricted-party list; and</li>
          <li>not have had a Covey account suspended or terminated before, unless we have given you written permission to return.</li>
        </ul>
        <p class="mt-4">
          You make each of these representations every time you use Covey, and
          you agree to tell us if any of them stops being true. We may terminate
          your account immediately if any of them is or becomes false.
        </p>
        <p class="mt-4">
          Covey is currently offered {SITE.launchRegion}. Access is by
          invitation, and we may limit, prioritise, or withdraw invitations as we
          see fit.
        </p>
      </section>

      <section id="account" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">3. Your account</h2>
        <p>
          You may sign in with an email and password, with Sign in with Apple, or
          with Sign in with Google. Give accurate information, keep it current,
          and keep your credentials safe. You are responsible for everything that
          happens under your account. Tell us at
          <a href={`mailto:${SITE.emails.support}`}>{SITE.emails.support}</a>
          straight away if you think someone else has access.
        </p>
        <p class="mt-4">
          One person, one account. Do not sell, rent, share, or transfer your
          account or your invitations.
        </p>
      </section>

      <section id="verification" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">4. Identity verification</h2>
        <p>
          Before you finish onboarding, Covey asks you to photograph a
          government-issued ID and take a selfie. Someone on our team compares
          them by eye to check the document looks genuine, that it appears to be
          yours, and that you are over 18. The
          <a href="/privacy#you-give">Privacy Policy</a> explains how those
          images are stored, who can see them, and how to have them deleted.
        </p>
        <div class="card p-5 mt-5">
          <p class="text-base">
            <strong class="text-ink">What this check is not.</strong> It is a
            visual review of a document, nothing more. It is not a background
            check, a criminal-records search, a sex-offender registry search, or
            a check of anyone's character, intentions, or history. A verified
            badge means someone showed us an ID. It does not mean we vouch for
            that person, and you should not treat it as though we do. See
            <a href="#no-screening">Section 9</a>.
          </p>
        </div>
        <p class="mt-5">
          Submitting a forged, altered, or borrowed document, or one belonging to
          someone else, is a material breach of these Terms and will result in
          permanent termination. It may also be a crime.
        </p>
      </section>

      <section id="service" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">5. The service, and that it is free</h2>
        <p>
          Covey helps people find, plan, and coordinate things to do together,
          and — if you turn it on — meet people to date.
        </p>
        <p class="mt-4">
          <strong class="text-ink">Covey is free.</strong> We do not charge for
          accounts or features, we do not process payments, and there are no
          subscriptions, purchases, or paid tiers. If that ever changes, we will
          publish updated terms and ask you to accept them before anything
          becomes payable. Nothing in the Service should be read as an offer to
          sell you anything.
        </p>
        <p class="mt-4">
          Money that changes hands around a plan is between you and whoever you
          give it to. If a plan involves a restaurant bill, a ticket, a cover
          charge, or a friend covering costs, Covey is not part of that
          arrangement, does not hold or transmit the money, and has no
          responsibility for it.
        </p>
        <p class="mt-4">
          Covey is early-access software. We may add, change, suspend, or
          discontinue any part of it, and features may be incomplete or
          experimental. We do not guarantee availability, uptime, or that your
          content will be preserved. Where a change materially reduces the
          Service, we will try to give notice in the app or by email first.
        </p>
      </section>

      <section id="your-content" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">6. Your content</h2>
        <p>
          "Your Content" is everything you put into Covey: plans and their
          details, posts and recaps, photos and other media, messages, comments,
          your profile and bio, group descriptions, reviews, and reports you send
          us. You own Your Content.
        </p>

        <h3 class="title-mono text-xl text-ink mt-6 mb-2">6.1 The licence you give us</h3>
        <p>
          You grant {entity} a worldwide, non-exclusive, royalty-free,
          transferable, sublicensable licence to host, store, copy, reformat for
          display, transmit, and show Your Content — for the sole purpose of
          operating, securing, supporting, and improving the Service and
          delivering Your Content to the people you shared it with. This licence
          exists so the product can function. It does not make us an owner of
          Your Content.
        </p>
        <p class="mt-4">
          We will not use your messages or non-public plan content for
          advertising, and we will not put Your Content in marketing material
          without asking you first.
        </p>

        <h3 class="title-mono text-xl text-ink mt-6 mb-2">6.2 How long the licence lasts</h3>
        <p>
          It ends when you delete the content or your account — except that
          content you already sent to other people may remain with them, copies
          may sit in routine backups for a limited period, and we may keep what
          we must for legal, safety, or enforcement reasons. See
          <a href="/privacy#retention">the retention table</a> and our
          <a href="/deletion">deletion page</a>.
        </p>

        <h3 class="title-mono text-xl text-ink mt-6 mb-2">6.3 What you promise about it</h3>
        <p>
          You represent and warrant that you own or have the rights to Your
          Content, that you have the consent of anyone identifiable in a photo
          you upload, that it infringes nobody's rights, and that it breaks
          neither these Terms nor the law. You are solely responsible for Your
          Content and for what follows from posting it.
        </p>

        <h3 class="title-mono text-xl text-ink mt-6 mb-2">6.4 Feedback</h3>
        <p>
          If you send us suggestions or feature requests, you grant us an
          unrestricted, perpetual, irrevocable right to use them without
          obligation or payment to you.
        </p>
      </section>

      <section id="ai" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">7. AI-generated content</h2>
        <p>
          Covey can draft text for you: a profile bio, a plan, a group
          description, a conversation opener. These features are optional and are
          produced by a third-party AI model, as the
          <a href="/privacy#ai">Privacy Policy</a> describes.
        </p>
        <p class="mt-4">
          AI output is a suggestion, generated automatically and not reviewed by
          a person. It can be inaccurate, inappropriate, or misleading, and
          similar text may be generated for other members. Check it before you
          use it. Once you keep or publish it, you are responsible for it exactly
          as if you had written it yourself, and it becomes Your Content under
          Section 6. We make no warranty about AI output and do not claim
          ownership of it.
        </p>
      </section>

      <section id="acceptable-use" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">8. Acceptable use</h2>
        <p>
          Our <a href="/safety">safety page</a> sets out the community standards
          we expect. As a condition of using the Service, you agree not to:
        </p>
        <ul class="mt-4 space-y-2 list-disc pl-6">
          {prohibited.map((rule) => <li>{rule}</li>)}
        </ul>
      </section>

      <section id="no-screening" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">9. We do not screen members</h2>
        <div class="card p-6">
          <p class="uppercase text-base tracking-wide">
            Covey does not run criminal background checks, sex-offender registry
            searches, reference checks, or any other screening of its members.
            The identity check in Section 4 confirms that a document was shown.
            It confirms nothing about a person's history, character, or
            intentions.
          </p>
          <p class="mt-4 text-base">
            We also do not verify what members say about themselves, and we do
            not vet plans, hosts, venues, activities, or the places anyone adds
            to a plan. A profile, a badge, or a plan appearing on Covey is not an
            endorsement or a recommendation by us, and is not a representation
            that anyone is safe to meet.
          </p>
        </div>
      </section>

      <section id="meeting" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">10. Meeting people, dating, and real-world risk</h2>
        <p>
          Covey exists to get people together offline, including romantically if
          you turn dating on. That carries real risk that no software removes.
          People misrepresent themselves. Some are dangerous.
        </p>
        <p class="mt-4">
          <strong class="text-ink">Take precautions.</strong> Meet in public the
          first time. Tell a friend where you are going and who with. Arrange
          your own transport. Do not send money, gifts, or account details to
          anyone you met here, however convincing the story. Leave any situation
          that feels wrong, and report it.
        </p>
        <p class="mt-4 uppercase text-base tracking-wide">
          You are solely responsible for your interactions with other members,
          online and in person. To the fullest extent permitted by law, you
          assume all risk arising out of those interactions and out of attending
          any plan, event, place, or venue, and you release {entity} and its
          officers, directors, employees, and agents from all claims, demands,
          damages, losses, and liabilities of every kind — known and unknown —
          arising out of or connected with them, including personal injury,
          death, assault, harassment, property damage, emotional distress, and
          financial loss caused by another member.
        </p>
        <p class="mt-4">
          You waive California Civil Code section 1542, and any comparable law of
          another jurisdiction, which provides: "A general release does not
          extend to claims that the creditor or releasing party does not know or
          suspect to exist in his or her favor at the time of executing the
          release, and that, if known by him or her, would have materially
          affected his or her settlement with the debtor or released party."
        </p>
        <p class="mt-4">
          Covey support is not an emergency service and we cannot intervene in a
          situation as it happens. If you or someone else is in immediate danger,
          contact local emergency services first, then tell us at
          <a href={`mailto:${SITE.emails.safety}`}>{SITE.emails.safety}</a>.
        </p>
      </section>

      <section id="reporting" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">11. Reporting, blocking, and moderation</h2>
        <p>
          You can block any member from inside the app, which stops them
          contacting you or seeing your content. You can report a person,
          message, plan, post, photo, place, group, or comment, and attach
          context. Reports go to our team.
        </p>
        <p class="mt-4">
          We may — but are not required to — review, monitor, or remove content.
          Where we believe someone has broken these Terms, our safety standards,
          or the law, or where we need to protect people or the Service, we may
          warn them, remove content, limit its visibility, restrict features,
          suspend the account temporarily, ban it permanently, preserve records,
          and report the matter to law enforcement. We may act on a single report
          or on our own initiative, and we may act before completing an
          investigation where the risk warrants it.
        </p>
        <p class="mt-4">
          Where it is practical and lawful, we will tell you what we did. If you
          think we got it wrong, email
          <a href={`mailto:${SITE.emails.support}`}>{SITE.emails.support}</a>
          and a person will look at it again. We keep records of reports and
          enforcement even after an account is deleted, so that a banned member
          cannot simply come back.
        </p>
        <p class="mt-4">
          Do not use reporting to harass someone. Repeated bad-faith reports are
          themselves a breach of Section 8.
        </p>
      </section>

      <section id="third-parties" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">12. Third-party services</h2>
        <p>
          Covey shows content from and links out to services we do not control —
          map and place data, Spotify playlists someone linked, venue pages, the
          App Store. We are not responsible for their content, availability,
          accuracy, or practices, and your use of them is governed by their own
          terms. A link is not an endorsement. Place information, including
          addresses and opening details, comes from third-party sources and may
          be wrong or out of date; check before you rely on it.
        </p>
      </section>

      <section id="copyright" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">13. Copyright and DMCA</h2>
        <p>
          We respond to notices of alleged copyright infringement under the
          Digital Millennium Copyright Act. Send a written notice to
          <a href={`mailto:${SITE.emails.support}`}>{SITE.emails.support}</a>
          with the subject line "DMCA notice", including:
        </p>
        <ul class="mt-4 space-y-2 list-disc pl-6">
          <li>your physical or electronic signature;</li>
          <li>identification of the copyrighted work you say was infringed;</li>
          <li>identification of the material you say is infringing, with enough detail for us to find it;</li>
          <li>your name, address, telephone number, and email address;</li>
          <li>a statement that you believe in good faith that the use is not authorised by the owner, its agent, or the law; and</li>
          <li>a statement, under penalty of perjury, that the notice is accurate and that you are the owner or authorised to act for them.</li>
        </ul>
        <p class="mt-4">
          If your content was removed and you believe that was a mistake, you may
          send a counter-notice to the same address. We terminate the accounts of
          repeat infringers in appropriate circumstances.
        </p>
      </section>

      <section id="our-ip" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">14. Covey's intellectual property</h2>
        <p>
          The Service — its software, design, text, graphics, and the Covey name
          and marks — belongs to {entity} and its licensors and is protected by
          intellectual property law. Subject to these Terms, we grant you a
          limited, revocable, non-exclusive, non-transferable, non-sublicensable
          licence to use the Service for your own personal, non-commercial
          purposes. Every right not expressly granted is reserved. Do not use our
          name or marks without our written permission.
        </p>
      </section>

      <section id="termination" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">15. Suspension, termination, and deletion</h2>
        <p>
          <strong class="text-ink">You can leave at any time.</strong> Delete
          your account from your profile settings in the app — see the
          <a href="/deletion">deletion page</a>. Deletion removes your profile,
          the plans you host, your posts, your messages, your bookmarks, and your
          preferences, and revokes your sign-in.
          <a href="/privacy#retention">The retention table</a> lists the narrow
          categories we keep and why.
        </p>
        <p class="mt-4">
          <strong class="text-ink">We can end or limit your access</strong> at
          any time, with or without notice, if you break these Terms, if we
          reasonably believe your use creates risk or legal exposure for us or
          others, if you are ineligible under Section 2, or if we discontinue the
          Service. Where the reason is a safety or legal risk, we may act
          immediately.
        </p>
        <p class="mt-4">
          On termination your licence to use the Service ends. Sections 6.2, 6.3,
          6.4, 9, 10, 11, 14, and 16 through 23 survive.
        </p>
      </section>

      <section id="disclaimers" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">16. Disclaimers</h2>
        <p class="uppercase text-base tracking-wide">
          The service is provided "as is" and "as available", without warranty of
          any kind, express, implied, or statutory. To the fullest extent
          permitted by law, {entity} disclaims all warranties, including the
          implied warranties of merchantability, fitness for a particular
          purpose, title, and non-infringement, and any warranty arising from
          course of dealing or usage of trade.
        </p>
        <p class="mt-4">
          We do not warrant that the Service will be uninterrupted, timely,
          secure, or error-free; that defects will be fixed; that content, place
          information, AI output, or recommendations are accurate or complete; or
          that the Service will meet your needs.
          <strong class="text-ink">
            We make no warranty whatsoever about the identity, conduct,
            character, history, or suitability of any member, host, or venue, or
            about the truth of anything a member tells you.
          </strong>
        </p>
        <p class="mt-4">
          Some jurisdictions do not allow the exclusion of certain warranties, so
          parts of this section may not apply to you.
        </p>
      </section>

      <section id="liability" class="scroll-mt-28">
        <h2 class="title-mono text-2xl text-ink mb-3">17. Limitation of liability</h2>
        <p class="uppercase text-base tracking-wide">
          To the fullest extent permitted by law, {entity} and its officers,
          directors, employees, and agents will not be liable for any indirect,
          incidental, special, consequential, exemplary, or punitive damages, or
          for any loss of profits, data, goodwill, or opportunity, arising out of
          or relating to the service or to your interactions with other members,
          whether based in contract, tort, statute, or any other theory, and
          whether or not we were told such damages were possible.
        </p>
        <p class="mt-4 uppercase text-base tracking-wide">
          Our total liability for all claims relating to the service will not
          exceed one hundred U.S. dollars ($100). Covey is provided free of
