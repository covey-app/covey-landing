---
import BaseLayout from "../layouts/BaseLayout.astro";
import CoveyMark from "../components/CoveyMark.astro";
---

<BaseLayout title="Thanks" description="Thanks — we've got it." noIndex={true}>
  <div class="max-w-xl mx-auto px-6 py-32 text-center">
    <div class="card-pinned p-12">
      <div class="flex justify-center mb-6">
        <CoveyMark variant="dots" dotSize={11} animate />
      </div>
      <span class="eyebrow block mb-4">Got it.</span>
      <h1 class="display text-4xl mb-4">Thanks — we've got it.</h1>
      <p class="text-ink-muted leading-relaxed mb-8">
        If you joined the waitlist, we'll email you the moment an invite is
        ready. If you sent us a message, we'll reply within a few days.
      </p>
      <a href="/" class="btn btn-primary px-8 py-4 text-xs">
        Back home
      </a>
    </div>
  </div>
</BaseLayout>
