{
  "redirects": [
    {
      "source": "/signup",
      "destination": "/waitlist",
      "permanent": false
    },
    {
      "source": "/activities",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/newsletter",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/newsletter/:path*",
      "destination": "/events",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
